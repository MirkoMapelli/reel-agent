  "segments": [
    {
      "start": 0.0,
      "end": 4.16,
      "text": "e se vi cessi che da kebabs potete nzuppare il vostro kebab in un bicchiere di salsa"
    },
    {
      "start": 4.16,
      "end": 6.72,
      "text": "sì ragazzi oggi proviamo questa novità appunto da kebawse"
    },
    {
      "start": 6.72,
      "end": 10.86,
      "text": "ovvero letteralmente un bicchierone di una salsa segreta che eventi cipolli giochè e clamorosa"
    },
    {
      "start": 10.86,
      "end": 12.36,
      "text": "ah e con anche una sorpresa crunchy"
    },
    {
      "start": 12.36,
      "end": 14.2,
      "text": "quindi preso il loro menu simply the best"
    },
    {
      "start": 14.2,
      "end": 16.32,
      "text": "con un kebab di vitello tacchino col bacon"
    },
    {
      "start": 16.32,
      "end": 18.46,
      "text": "insalata ketchup maionese patatine fritte"
    },
    {
      "start": 18.46,
      "end": 20.42,
      "text": "e poi quindi iniziato con l'nzuppo"
    },
    {
      "start": 20.42,
      "end": 22.7,
      "text": "prima nel bicchierone pieno di salsa"
    },
    {
      "start": 22.7,
      "end": 24.1,
      "text": "quindi che è be' ragazzi nel crunchy"
    },
    {
      "start": 24.1,
      "end": 25.86,
      "text": "ovvero questo crumble di patatine fritte"
    },
    {
      "start": 25.86,
      "end": 27.46,
      "text": "che aggiungono questa parte croccante"
    },
    {
      "start": 27.46,
      "end": 29.52,
      "text": "che poi è l'assaggio rende il kebab a clamo"
    },
    {
      "start": 29.52,
      "end": 32.2,
      "text": "lo so e poi ragazzi la taccia anche un'altra modalità"
    },
    {
      "start": 32.2,
      "end": 35.64,
      "text": "oltre all'inzuppo vero quella di versarci direttamente sopra la salsa"
    },
    {
      "start": 35.64,
      "end": 37.44,
      "text": "e poi appunto passarla sempre nel crunchy"
    },
    {
      "start": 37.44,
      "end": 39.28,
      "text": "modalità che ammetto essere la mia preferita"
    },
    {
      "start": 39.28,
      "end": 41.68,
      "text": "e poi ragazzi il resto del procedimento resta sempre uguale"
    },
    {
      "start": 41.68,
      "end": 43.4,
      "text": "un bel morso con tanta arroganza"
    },
    {
      "start": 43.4,
      "end": 46.2,
      "text": "ed ovviamente il bicchierone di salsa potete sfruttarlo anche con le patatine"
    },
    {
      "start": 46.2,
      "end": 47.94,
      "text": "come ho fatto io che ho preso le patate dolci"
    },
    {
      "start": 47.94,
      "end": 49.66,
      "text": "e le ho anche loro inzuppate per bene"
    },
    {
      "start": 49.66,
      "end": 51.64,
      "text": "patate dolci che tra l'altro meritano veramente tanto"
    },
    {
      "start": 51.64,
      "end": 54.7,
      "text": "quindi ragazzi volete provare anche voi il bicchierone di salsa passate da kebab"
    }
  ],
