    {
      "idx": 9,
      "start": 24.567,
      "end": 26.167,
      "dur": 1.6,
      "transcript": "era molto buona in quanto nonostante"
    },
    {
      "idx": 10,
      "start": 26.167,
      "end": 27.667,
      "dur": 1.5,
      "transcript": "fosse ben ricca di cioccolato"
