  "segments": [
    {
      "start": 0.0,
      "end": 3.58,
      "text": "e se ricensi che questa è la migliore colazione di tutta Milano e che questo è senza dubbio"
    },
    {
      "start": 3.58,
      "end": 8.12,
      "text": "il cinamorrol più clamoroso di Milano oggi ragazzi siamo da signor lievito proviamo la loro colazione"
    },
    {
      "start": 8.12,
      "end": 12.66,
      "text": "il posto è veramente carinissimo ma super piccolo e fidatevi che dovete venire presto perché se"
    },
    {
      "start": 12.66,
      "end": 15.98,
      "text": "non c'è già la fila ovviamente mi sono preso un classico cappuccino come potete vedere veramente"
    },
    {
      "start": 15.98,
      "end": 21.2,
      "text": "carino il cinamorrol ma prima di quello ho assaggiato altre cose tra cui questa sorta di treccia"
    },
    {
      "start": 21.2,
      "end": 25.76,
      "text": "al cioccolato quella quale ho iniziato veramente alla grande perché era molto buona in quanto"
    },
    {
      "start": 25.76,
      "end": 30.22,
      "text": "nonostante fosse ben ricca di cioccolato non era troppo invasivo e lasciava spazio a quell'impasto"
    },
    {
      "start": 30.22,
      "end": 34.56,
      "text": "veramente veramente buono passando al pezzo forte guardate il loro cinamorrol quanto cavolo era morbido"
    },
    {
      "start": 34.56,
      "end": 38.44,
      "text": "e quanto era ricco di crema al burro perché sì quella è tutta crema al burro io credo che"
    },
    {
      "start": 38.44,
      "end": 42.0,
      "text": "ormai non ci sia più storia il cinamorrol è letteralmente superiore al cornetto e con lui"
    },
    {
      "start": 42.0,
      "end": 45.7,
      "text": "ho avuto la conferma della qualità degli impasti di signor lievito ho poi concluso"
    },
    {
      "start": 45.7,
      "end": 49.08,
      "text": "assaggiando quest'altro dolce con la crema niente male anche lui un po costoso ma"
    },
    {
      "start": 49.08,
      "end": 50.76,
      "text": "signor lievito assolutamente era provare"
    }
  ],
