  "segments": [
    {
      "start": 0.0,
      "end": 2.52,
      "text": "La mia pizza senza glutine preferita a Milano."
    },
    {
      "start": 2.58,
      "end": 7.22,
      "text": "Eh sì ragazzi, qual è la ricerca della miglior pizza senza glutine di Milano continua e oggi"
    },
    {
      "start": 7.22,
      "end": 8.36,
      "text": "siamo da Pepperino e Milano."
    },
    {
      "start": 8.38,
      "end": 11.4,
      "text": "Una pizzeria molto grande specializzata nel senza glutine."
    },
    {
      "start": 11.46,
      "end": 14.24,
      "text": "Un posto che tra l'altro mi avete consigliato voi nei commenti degli altri video."
    },
    {
      "start": 14.34,
      "end": 17.64,
      "text": "Diciamo che in questa serata ero particolarmente affamato e qui ho deciso di provare una"
    },
    {
      "start": 17.64,
      "end": 21.16,
      "text": "leggerissima quattro formaggi e una classica view stare fatatine."
    },
    {
      "start": 21.26,
      "end": 24.7,
      "text": "Forse non la miglior scelta per valutare semplicemente l'impasto della pizza"
    },
    {
      "start": 24.7,
      "end": 26.66,
      "text": "ma comunque due pizza e clamorose."
    },
    {
      "start": 26.66,
      "end": 29.9,
      "text": "L'impasto ottimo gli è evitato leggermente ma in generale una versione"
    },
    {
      "start": 29.9,
      "end": 33.5,
      "text": "diversa dalla classica pizza napoletana ma molto più simile alla versione romana."
    },
    {
      "start": 33.58,
      "end": 36.46,
      "text": "Quindi un po' più bassa, abbastanza croccante e ovviamente ben cotta."
    },
    {
      "start": 36.52,
      "end": 39.34,
      "text": "Purtro cosa la considerate una pizza senza glutine sono comunque anche le patatine"
    },
    {
      "start": 39.34,
      "end": 42.0,
      "text": "dovendo avere una frigidrice a parte per poter essere fritte."
    },
    {
      "start": 42.1,
      "end": 46.12,
      "text": "Quindi pizza gluten free, clamorosa, ma devo purtroppo far notare che i tempi"
    },
    {
      "start": 46.12,
      "end": 49.3,
      "text": "gli attesa soprattutto quando eravamo una tavolata più numerosa sono stati"
    },
    {
      "start": 49.3,
      "end": 50.38,
      "text": "decisamente troppo lunghi."
    }
  ],
