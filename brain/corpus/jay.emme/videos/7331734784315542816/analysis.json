  "segments": [
    {
      "start": 0.0,
      "end": 2.22,
      "text": "Provo la cucina vegana per la prima volta nella mia vita."
    },
    {
      "start": 2.3,
      "end": 4.12,
      "text": "E sì, questo è un hamburger completamente vegano."
    },
    {
      "start": 4.2,
      "end": 5.66,
      "text": "Siamo da Mibio, Mistro, a Milano."
    },
    {
      "start": 5.68,
      "end": 7.1,
      "text": "E questi sono alcuni dei piatti comangiati."
    },
    {
      "start": 7.2,
      "end": 9.62,
      "text": "Partendo da una serie di antipassi, tra cui queste chips di patate"
    },
    {
      "start": 9.62,
      "end": 11.64,
      "text": "accompagnato ovviamente con una maionese vegana,"
    },
    {
      "start": 11.68,
      "end": 12.78,
      "text": "queste crocchette di patate,"
    },
    {
      "start": 12.88,
      "end": 14.66,
      "text": "oppure questa crema di fave con cicoria,"
    },
    {
      "start": 14.78,
      "end": 16.06,
      "text": "che però non mi ha intruso smatto molto,"
    },
    {
      "start": 16.18,
      "end": 19.48,
      "text": "o queste bruschette con un mousse di ceci alla barba bietola e pomodori secchi."
    },
    {
      "start": 19.6,
      "end": 21.5,
      "text": "Per passaggiare la loro caponata siciliana"
    },
    {
      "start": 21.5,
      "end": 23.28,
      "text": "e poi il punto forte secondo me tra gli antipassi"
    },
    {
      "start": 23.28,
      "end": 25.26,
      "text": "ovvero queste sorte di me lanzare la parmigiana."
    },
    {
      "start": 25.36,
      "end": 26.54,
      "text": "Sono poi passato il loro falafel,"
    },
    {
      "start": 26.54,
      "end": 28.1,
      "text": "anche se sinceramente mi aspettavo di più,"
    },
    {
      "start": 28.26,
      "end": 30.12,
      "text": "e poi sono arrivato a lui, il portobello burger."
    },
    {
      "start": 30.2,
      "end": 32.1,
      "text": "Il loro appunto hamburger vegano"
    },
    {
      "start": 32.1,
      "end": 34.2,
      "text": "servito sia con chips normali che americane."
    },
    {
      "start": 34.28,
      "end": 35.04,
      "text": "Quindi patate dolci."
    },
    {
      "start": 35.1,
      "end": 36.64,
      "text": "Io sinceramente ho preferito le classiche."
    },
    {
      "start": 36.76,
      "end": 37.9,
      "text": "Ma passando all'hamburger in sé,"
    },
    {
      "start": 38.1,
      "end": 40.52,
      "text": "io vi giuro che il patty sapeva letteralmente di carne."
    },
    {
      "start": 40.64,
      "end": 41.44,
      "text": "E se non me l'avessero detto,"
    },
    {
      "start": 41.56,
      "end": 42.9,
      "text": "non avrei mai distinto da uno normale."
    },
    {
      "start": 43.14,
      "end": 45.26,
      "text": "Charatteristica dell'hamburger ovviamente anche il loro pane,"
    },
    {
      "start": 45.38,
      "end": 47.16,
      "text": "che non è pane ma semplicemente un fungo."
    },
    {
      "start": 47.26,
      "end": 48.04,
      "text": "Che non era male, dai."
    },
    {
      "start": 48.06,
      "end": 49.6,
      "text": "Ho passaggiato la loro cheesecake vegana,"
    },
    {
      "start": 49.64,
      "end": 51.02,
      "text": "metà i frutti di bosco e metà al mango."
    },
    {
      "start": 51.04,
      "end": 53.08,
      "text": "Ma metto che risultava troppo leggera,"
    },
    {
      "start": 53.08,
      "end": 54.82,
      "text": "la cheesecake deve essere bella dolce."
    },
    {
      "start": 54.88,
      "end": 56.52,
      "text": "E anche il loro panettone vegano, ragazzi,"
    },
    {
      "start": 56.52,
      "end": 57.82,
      "text": "sentiva la mancanza del buco."
    },
    {
      "start": 57.86,
      "end": 59.58,
      "text": "In generale, cucina vegana approvata,"
    },
    {
      "start": 59.68,
      "end": 60.48,
      "text": "ma non per i dolci."
    }
