  "segments": [
    {
      "start": 0.0,
      "end": 3.54,
      "text": "oggi giornata tostissima, abbiamo esame, abbiamo legday, abbiamo un sacco di cose da fare"
    },
    {
      "start": 3.54,
      "end": 9.44,
      "text": "e iniziamo così questa giornata veramente intensa con un kilo e mezzo di uova al boom e poi un bel porridge con della marmellata light"
    },
    {
      "start": 9.44,
      "end": 14.94,
      "text": "post colazione qua mi vedete bello carico per andare ad affrontare quest'esame infatti vedete anche il passo bello svelto"
    },
    {
      "start": 14.94,
      "end": 16.9,
      "text": "e sono gli ultimi istanti prima dell'esame"
    },
    {
      "start": 16.9,
      "end": 20.98,
      "text": "e invece questa è la mia faccia dopo l'esame vedete una faccia sconsolata"
    },
    {
      "start": 20.98,
      "end": 23.54,
      "text": "esame è andato veramente male ma va be'"
    },
    {
      "start": 23.58,
      "end": 27.86,
      "text": "qui mi vedete consumare un tristissimo pranzo con una faccia affranta ovviamente erano mangiato solo in salata"
    },
    {
      "start": 27.86,
      "end": 30.26,
      "text": "però questo pezzo di video rappresente esattamente come mi sentivo"
    },
    {
      "start": 30.26,
      "end": 33.88,
      "text": "è visto che fare schifo comunque un po' stanca ovviamente pisolino supermeritato"
    },
    {
      "start": 33.88,
      "end": 37.0,
      "text": "e dopo tre ore e mezzo di dormita 20 minuti di studio mi sembrava un po' doverosi"
    },
    {
      "start": 37.0,
      "end": 39.02,
      "text": "e qua ragazza arriva il secondo fallimento della giornata"
    },
    {
      "start": 39.02,
      "end": 41.82,
      "text": "perché mentre andava a fare un bel legday mi sono fermato un secondo in scuola guida"
    },
    {
      "start": 41.82,
      "end": 45.48,
      "text": "solamente per lasciare dei documenti ma poi mi hanno tirato dentro e mi hanno costretto a fare anche la lezione"
    },
    {
      "start": 45.48,
      "end": 48.4,
      "text": "finendo per non avere tempo per il legday che mi toccherà recuperare domani"
    },
    {
      "start": 48.4,
      "end": 51.68,
      "text": "che dire ragazzi questo percorso di miglioramento non inizia dei migliori dei modi"
    },
    {
      "start": 51.68,
      "end": 55.06,
      "text": "ma l'importante è non demordere e domani miglioreremo sicuramente in qualcosa"
    }
  ],
