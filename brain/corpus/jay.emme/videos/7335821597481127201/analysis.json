  "segments": [
    {
      "start": 0.0,
      "end": 2.86,
      "text": "Ma cosa mangi l'un giorno 2200 calorie in definizione?"
    },
    {
      "start": 3.02,
      "end": 5.9,
      "text": "Oggi nuova what a itina day partendo e solvveli dalla colazione"
    },
    {
      "start": 5.9,
      "end": 8.2,
      "text": "in cui abbiamo due uova con un po' di albumi"
    },
    {
      "start": 8.2,
      "end": 12.42,
      "text": "il mio solito porcino di avena fatto con sopra la cremina di cacao mare e protina in polvere"
    },
    {
      "start": 12.42,
      "end": 15.54,
      "text": "passando al pranzo, qua abbiamo una fonte di carburati molto particolare"
    },
    {
      "start": 15.54,
      "end": 19.6,
      "text": "infatti ho mangiato un pezzo di focaccia e questi gnocchi di patate fatti in frigidrice ad aria"
    },
    {
      "start": 19.6,
      "end": 23.76,
      "text": "mentre come verdura abbiamo questa Caesar salad fatta con anche del petto di pollo e della salsa Caesar"
    },
    {
      "start": 23.76,
      "end": 27.72,
      "text": "ragazzi oggi sono stato abbastanza pressibili infatti ho fatto di entrare questo pezzo di focaccia in macros"
    },
    {
      "start": 27.72,
      "end": 29.32,
      "text": "e devo dire che me la sono goduta per bene"
    },
    {
      "start": 29.32,
      "end": 31.26,
      "text": "anche gli gnocchi di patate però fatti in frigidrice ad aria"
    },
    {
      "start": 31.26,
      "end": 33.58,
      "text": "belli croccanti sono veramente tanta roba se è spezzati bene"
    },
    {
      "start": 33.58,
      "end": 35.36,
      "text": "per cena abbiamo questi due hamburger di pollo"
    },
    {
      "start": 35.36,
      "end": 38.5,
      "text": "praticamente mi sono fatto tre panini con un po' di salsa barbi più zero"
    },
    {
      "start": 38.5,
      "end": 42.16,
      "text": "poi abbiamo come contorno queste zucchine fatte sempre in frigidrice ad aria"
    },
    {
      "start": 42.16,
      "end": 46.1,
      "text": "ok effettivamente queste hamburger di pollo non sono come il petto di pollo perché hanno molti più grassi"
    },
    {
      "start": 46.1,
      "end": 47.86,
      "text": "però sono veramente tanto più buoni quindi"
    },
    {
      "start": 48.38,
      "end": 49.4,
      "text": "tanta tanta roba"
    },
    {
      "start": 49.4,
      "end": 51.02,
      "text": "penso proprio che li mangerò molto più spesso"
    },
    {
      "start": 51.02,
      "end": 52.52,
      "text": "e prena Anna bea ragazzi di routine"
    },
    {
      "start": 52.52,
      "end": 55.82,
      "text": "ormai da qualche anno questa parte mela, yogurt greco e protina in polvere"
    },
    {
      "start": 55.82,
      "end": 57.08,
      "text": "e anche un po' di cacao maro"
    }
  ],
