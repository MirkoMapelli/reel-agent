  "segments": [
    {
      "start": 0.0,
      "end": 2.74,
      "text": "Ma cosa mangia in un giorno in definizione a 2200 calorie?"
    },
    {
      "start": 3.04,
      "end": 5.62,
      "text": "Oggi altro full day of eating partendo dalla colazione"
    },
    {
      "start": 5.62,
      "end": 7.68,
      "text": "in cui abbiamo un paio di uova con un po' di albume"
    },
    {
      "start": 7.68,
      "end": 11.62,
      "text": "e poi un bel po' di gida vena con una cremina sopra fatta con le proteine in polvere e il cacao male"
    },
    {
      "start": 11.62,
      "end": 13.26,
      "text": "Per pranzo ragazzi la svolta"
    },
    {
      "start": 13.26,
      "end": 16.8,
      "text": "mi sono fatto questa sorta di pasta al forno fatta con la mozzarella proteica"
    },
    {
      "start": 16.8,
      "end": 19.16,
      "text": "ovviamente un bel po' di pasta pomodore"
    },
    {
      "start": 19.16,
      "end": 21.28,
      "text": "poi un po' di grana sopra per formare la crosticina"
    },
    {
      "start": 21.28,
      "end": 25.3,
      "text": "fatto tutto in frigidia d'aria devo dire che è veramente la svolta, spettacolare"
    },
    {
      "start": 25.3,
      "end": 27.34,
      "text": "Per cena ragazzi abbiamo del pesce spada"
    },
    {
      "start": 27.34,
      "end": 29.4,
      "text": "che forse uno dei mie tipi di pesce preferiti"
    },
    {
      "start": 29.4,
      "end": 32.34,
      "text": "ovviamente come fonte di carbon, un bel po' di gallette di allexiori"
    },
    {
      "start": 32.34,
      "end": 34.68,
      "text": "un po' gusto pizza, un po' gusto pecorino piccante"
    },
    {
      "start": 34.68,
      "end": 38.36,
      "text": "e poi la mia solita insalatona di finocchi e arancia che è una cosa incredibile"
    },
    {
      "start": 38.36,
      "end": 41.04,
      "text": "e come prena ormai come sempre la mia solita mela"
    },
    {
      "start": 41.04,
      "end": 43.86,
      "text": "è il mio yogurt greco con un po' di proteine in polvere e cacao amaro"
    }
  ],
