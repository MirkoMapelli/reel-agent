  "segments": [
    {
      "start": 0.0,
      "end": 6.26,
      "text": "Pizza fritta, gluten fria, Milano? Oggi ragazzi proviamo un'altra pizzeria che ha opzioni senza glutine e vedremo se sarà finalmente lei la migliore"
    },
    {
      "start": 6.26,
      "end": 12.06,
      "text": "Ci troviamo dalla pizzeria a positano e avendo anche diverse antipassi senza glutine noi abbiamo iniziato da questo crocchè di patate"
    },
    {
      "start": 12.06,
      "end": 17.42,
      "text": "Molto sfizioso con un ottimo impanatura e dopo di che avendo visto che sul menu c'era anche l'opzione della pizza fritta"
    },
    {
      "start": 17.42,
      "end": 21.94,
      "text": "abbiamo assolutamente voluto provarla, bella carica sia di pomodoro sopra che di ripieno dentro"
    },
    {
      "start": 21.94,
      "end": 27.5,
      "text": "Con ricotta mozzarella e salame, trittura ovviamente perfetta con tra l'altro anche la mozzarella che filava alla grande"
    },
    {
      "start": 27.5,
      "end": 32.42,
      "text": "Ed è un impasto molto buono è anche vero che questa era la mia prima pizza fritta senza glutine ma mi ha stupito"
    },
    {
      "start": 32.42,
      "end": 38.44,
      "text": "tantissimo perché l'impasto essendo anche fritto si sentiva ancora meno la differenza dopo di che però abbiamo voluto provare la pizza normale"
    },
    {
      "start": 38.44,
      "end": 44.18,
      "text": "senza glutine ma col corricione ripiene ed è per questo che è un filo più piccolo ma guardate che bella anche qua sull'impasto"
    },
    {
      "start": 44.18,
      "end": 48.46,
      "text": "Niente niente da dire salato al giusto per niente gommoso e cotto la perfezione"
    },
    {
      "start": 48.46,
      "end": 53.8,
      "text": "Quindi davvero uno di migliori impasti senza glutine che abbiamo mai provato o poi voluto anche provare la sua controparte"
    },
    {
      "start": 53.8,
      "end": 60.48,
      "text": "normale per capire un po la differenza e devo dire che sì ovviamente molto buona anche quella normale ma quelle senza glutine non ha niente da invidiare"
    },
    {
      "start": 60.48,
      "end": 63.56,
      "text": "Pizzeria positano me l'avete considerate in tanti e io l'ho capito il perché"
    }
  ],
