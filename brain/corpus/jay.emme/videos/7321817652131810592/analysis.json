  "segments": [
    {
      "start": 0.0,
      "end": 2.18,
      "text": "Ciao ragazzi sono Jay e voglio migliorare la mia vita."
    },
    {
      "start": 2.44,
      "end": 6.16,
      "text": "Sì perché per me siamo nel 2024, questo 2023 non mi ha fatto soddisfatto."
    },
    {
      "start": 6.26,
      "end": 10.42,
      "text": "Ho un sacco di obiettivi che purtroppo non ho raggiunto e non voglio che ci accadà di nuovo quest'anno."
    },
    {
      "start": 10.52,
      "end": 16.24,
      "text": "Quindi vi porterò con me nel miglioramento di ogni singola spettola della mia vita che sia diet, allenamento, lettura, studio, qualsiasi cosa."
    },
    {
      "start": 16.48,
      "end": 19.8,
      "text": "A partire per esempio dall'esame che ho domani, il mio primo esame ma fa niente."
    },
    {
      "start": 20.02,
      "end": 26.04,
      "text": "Quindi se non siete soddisfatti della vostra vita, se avete voglia di cambiare avete bisogno di fuori motivazione iniziate a seguirmi e motiviamoci insieme."
    }
  ],
