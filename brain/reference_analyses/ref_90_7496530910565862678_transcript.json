  "aligned_shots": [
    {
      "shot_idx": 0,
      "start": 0.0,
      "end": 2.533,
      "dur": 2.533,
      "transcript": "La miglior pizzeria di Milano! Oggi ragazzi continuiamo il nostro"
    },
    {
      "shot_idx": 1,
      "start": 2.533,
      "end": 3.733,
      "dur": 1.2,
      "transcript": "tour delle migliori pizzeria"
    },
    {
      "shot_idx": 2,
      "start": 3.733,
      "end": 5.067,
      "dur": 1.333,
      "transcript": "appunto di tutto Milano"
    },
    {
      "shot_idx": 3,
      "start": 5.067,
      "end": 7.033,
      "dur": 1.967,
      "transcript": "provando cocciuto. Un locale che in realtà è un"
    },
    {
      "shot_idx": 4,
      "start": 7.033,
      "end": 8.667,
      "dur": 1.633,
      "transcript": "ristorante pizzeria con un attenzione"
    },
    {
      "shot_idx": 5,
      "start": 8.667,
      "end": 10.867,
      "dur": 2.2,
      "transcript": "particolare alle materie prime e specializzate in pizza"
    },
    {
      "shot_idx": 6,
      "start": 10.867,
      "end": 14.833,
      "dur": 3.967,
      "transcript": "contemporanea. Noi abbiamo però ovviamente iniziato con degli antipastini, con queste frittatine caccio"
    },
    {
      "shot_idx": 7,
      "start": 14.833,
      "end": 16.633,
      "dur": 1.8,
      "transcript": "e pepe, super croccanti e filanti"
    },
    {
      "shot_idx": 8,
      "start": 16.633,
      "end": 18.633,
      "dur": 2.0,
      "transcript": "e perfette con questa salsa al pecorino romano."
    },
    {
      "shot_idx": 9,
      "start": 18.633,
      "end": 20.067,
      "dur": 1.433,
      "transcript": "Per poi continuare con quella che viene chiamata"
    },
    {
      "shot_idx": 10,
      "start": 20.067,
      "end": 22.667,
      "dur": 2.6,
      "transcript": "scarpetta cocciuta, ovvero un acciota di salsa"
    },
    {
      "shot_idx": 11,
      "start": 22.667,
      "end": 24.333,
      "dur": 1.667,
      "transcript": "di pomodoro con della pasta fritta"
    },
    {
      "shot_idx": 12,
      "start": 24.333,
      "end": 26.367,
      "dur": 2.033,
      "transcript": "stile e mio occo fritto, che serve appunto per poter"
    },
    {
      "shot_idx": 13,
      "start": 26.367,
      "end": 28.0,
      "dur": 1.633,
      "transcript": "fare la scarpetta nel pomodoro. Davvero"
    },
    {
      "shot_idx": 14,
      "start": 28.0,
      "end": 29.933,
      "dur": 1.933,
      "transcript": "un ottimo idea soprattutto perché la salsa potevate"
    },
    {
      "shot_idx": 15,
      "start": 29.933,
      "end": 31.733,
      "dur": 1.8,
      "transcript": "letteralmente berla da quanto era buona."
    },
    {
      "shot_idx": 16,
      "start": 31.733,
      "end": 34.2,
      "dur": 2.467,
      "transcript": "Ma passando al punto forte della serata, ovvero le due pizze,"
    },
    {
      "shot_idx": 17,
      "start": 34.2,
      "end": 36.167,
      "dur": 1.967,
      "transcript": "io ho provato la loro margherita"
    },
    {
      "shot_idx": 18,
      "start": 36.167,
      "end": 38.967,
      "dur": 2.8,
      "transcript": "stracciatella e la propole pizzeria, entrambi davvero davvero belle. Maldendo"
    },
    {
      "shot_idx": 19,
      "start": 38.967,
      "end": 40.967,
      "dur": 2.0,
      "transcript": "la margherita stracciatella troviamo il pomodoro,"
    },
    {
      "shot_idx": 20,
      "start": 40.967,
      "end": 44.3,
      "dur": 3.333,
      "transcript": "la stracciatella, una porre di pesto, parmigiano e olio, una pizza che"
    },
    {
      "shot_idx": 21,
      "start": 44.3,
      "end": 47.133,
      "dur": 2.833,
      "transcript": "vi assicuro che era tanto bella quanto buona. Tre ingredienti con"
    },
    {
      "shot_idx": 22,
      "start": 47.133,
      "end": 49.433,
      "dur": 2.3,
      "transcript": "colori e sapori ben distinti che compagnavano un"
    },
    {
      "shot_idx": 23,
      "start": 49.433,
      "end": 51.267,
      "dur": 1.833,
      "transcript": "impasto che a me piaciuto veramente tanto,"
    },
    {
      "shot_idx": 24,
      "start": 51.267,
      "end": 53.1,
      "dur": 1.833,
      "transcript": "soprattutto il cornicione, piuttosto spesso,"
    },
    {
      "shot_idx": 25,
      "start": 53.1,
      "end": 54.8,
      "dur": 1.7,
      "transcript": "perfetto e si è accompagnato con ciò che"
    },
    {
      "shot_idx": 26,
      "start": 54.8,
      "end": 57.3,
      "dur": 2.5,
      "transcript": "rimaneva della nostra scarpetta. Passando invece la prova alle"
    },
    {
      "shot_idx": 27,
      "start": 57.3,
      "end": 60.4,
      "dur": 3.1,
      "transcript": "pepe troviamo una bufra fumicata del pomodoro, una julienne"
    },
    {
      "shot_idx": 28,
      "start": 60.4,
