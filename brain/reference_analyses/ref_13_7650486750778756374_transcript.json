  "aligned_shots": [
    {
      "shot_idx": 0,
      "start": 0.0,
      "end": 2.167,
      "dur": 2.167,
      "transcript": "Il locale più virale di Milano. Oggi sono"
    },
    {
      "shot_idx": 1,
      "start": 2.167,
      "end": 4.233,
      "dur": 2.067,
      "transcript": "finalmente andato a provare Beato The Milano,"
    },
    {
      "shot_idx": 2,
      "start": 4.233,
      "end": 6.267,
      "dur": 2.033,
      "transcript": "un posto in cui volevo andare da vero e tanto tempo."
    },
    {
      "shot_idx": 3,
      "start": 6.267,
      "end": 8.267,
      "dur": 2.0,
      "transcript": "Super famoso sui social per il loro vastissimo"
    },
    {
      "shot_idx": 4,
      "start": 8.267,
      "end": 10.067,
      "dur": 1.8,
      "transcript": "menu e ovviamente per le loro"
    },
    {
      "shot_idx": 5,
      "start": 10.067,
      "end": 12.833,
      "dur": 2.767,
      "transcript": "cottolette giganti. Che è stato appunto il piatto da cui vi ho iniziato,"
    },
    {
      "shot_idx": 6,
      "start": 12.833,
      "end": 16.9,
      "dur": 4.067,
      "transcript": "provando ovviamente la cottolette nella versione gigante con funghi porcini,"
    },
    {
      "shot_idx": 7,
      "start": 16.9,
      "end": 18.667,
      "dur": 1.767,
      "transcript": "salsiccia di norcia e fonduta di zola"
    },
    {
      "shot_idx": 8,
      "start": 18.667,
      "end": 22.7,
      "dur": 4.033,
      "transcript": "accompagnati anche dalle patatine fritte. Vi assicuro che in video la grandezza non rende per niente"
    },
    {
      "shot_idx": 9,
      "start": 22.7,
      "end": 24.233,
      "dur": 1.533,
      "transcript": "merai enorme, davvero difficile"
    },
    {
      "shot_idx": 10,
      "start": 24.233,
      "end": 25.967,
      "dur": 1.733,
      "transcript": "da finire anche se divise in due. Cioè che mi"
    },
    {
      "shot_idx": 11,
      "start": 25.967,
      "end": 28.033,
      "dur": 2.067,
      "transcript": "è stupito parare alla cottura, era veramente cotta"
    },
    {
      "shot_idx": 12,
      "start": 28.033,
      "end": 30.033,
      "dur": 2.0,
      "transcript": "bene e dentro non era per niente secco. Noi"
    },
    {
      "shot_idx": 13,
      "start": 30.033,
      "end": 34.567,
      "dur": 4.533,
      "transcript": "abbiamo poi proseguito ovviamente con la pizza, prendendola a piovano polpette, con ragù di carne,"
    },
    {
      "shot_idx": 14,
      "start": 34.567,
      "end": 37.1,
      "dur": 2.533,
      "transcript": "polpette e burrata. In pasto ben livitato"
    },
    {
      "shot_idx": 15,
      "start": 37.1,
      "end": 38.3,
      "dur": 1.2,
      "transcript": "stilena poletano ma un"
    },
    {
      "shot_idx": 16,
      "start": 38.3,
      "end": 39.933,
      "dur": 1.633,
      "transcript": "po' più cotta. Cosa molto apprezzato in"
    },
    {
      "shot_idx": 17,
      "start": 39.933,
      "end": 41.7,
      "dur": 1.767,
      "transcript": "quanto non aveva la consistenza gommosa. È davvero"
    },
    {
      "shot_idx": 18,
      "start": 41.7,
      "end": 43.533,
      "dur": 1.833,
      "transcript": "super buona soprattutto con questa burrata"
    },
    {
      "shot_idx": 19,
      "start": 43.533,
      "end": 44.7,
      "dur": 1.167,
      "transcript": "bella fresca al centro"
    },
    {
      "shot_idx": 20,
      "start": 44.7,
      "end": 48.867,
      "dur": 4.167,
      "transcript": "e queste polpette giganti super saporite. Ed infine per concludere abbiamo preso uno dei dessert"
    },
    {
      "shot_idx": 21,
      "start": 48.867,
      "end": 51.833,
      "dur": 2.967,
      "transcript": "più apprezzati da Beato The Milano, ovvero il loro tiramisu al"
    },
    {
      "shot_idx": 22,
      "start": 51.833,
      "end": 53.833,
      "dur": 2.0,
      "transcript": "kinderbueno e anche la cheesecake al pistacchio."
    },
    {
      "shot_idx": 23,
      "start": 53.833,
      "end": 56.067,
      "dur": 2.233,
      "transcript": "Tiramisu al kinderbueno che ho apprezzato molto,"
    },
    {
      "shot_idx": 24,
      "start": 56.067,
      "end": 57.833,
      "dur": 1.767,
      "transcript": "nonostante non mi ricordasse un vero proprio"
    },
    {
      "shot_idx": 25,
      "start": 57.833,
      "end": 59.2,
      "dur": 1.367,
      "transcript": "tiramisu. E ci schiega il pistacchio non"
    },
    {
      "shot_idx": 26,
      "start": 59.2,
      "end": 60.867,
      "dur": 1.667,
      "transcript": "troppo pesante, insomma davvero un posto"
    },
    {
      "shot_idx": 27,
      "start": 60.867,
      "end": 62.367,
      "dur": 1.5,
      "transcript": "in cui andrebbe provato tutto il menu."
    }
