  "aligned_shots": [
    {
      "shot_idx": 0,
      "start": 0.0,
      "end": 2.033,
      "dur": 2.033,
      "transcript": "Il pollo più croccante di tutta Milano e gli"
    },
    {
      "shot_idx": 1,
      "start": 2.033,
      "end": 3.867,
      "dur": 1.833,
      "transcript": "spaghetti con Buster e Cedar. Se"
    },
    {
      "shot_idx": 2,
      "start": 3.867,
      "end": 5.933,
      "dur": 2.067,
      "transcript": "ragazzi questo è quello che dovrebbe essere Jolly Bee,"
    },
    {
      "shot_idx": 3,
      "start": 5.933,
      "end": 7.1,
      "dur": 1.167,
      "transcript": "un fast food filipino,"
    },
    {
      "shot_idx": 4,
      "start": 7.1,
      "end": 8.1,
      "dur": 1.0,
      "transcript": "famoso per la"
    },
    {
      "shot_idx": 5,
      "start": 8.1,
      "end": 11.6,
      "dur": 3.5,
      "transcript": "croccantezza del suo pollo e per i suoi spaghetti. Due cose che mi hanno incuriosito troppo,"
    },
    {
      "shot_idx": 6,
      "start": 11.6,
      "end": 14.133,
      "dur": 2.533,
      "transcript": "ho dovuto quindi provarlo. Ho quindi ordinato un loro bucket di"
    },
    {
      "shot_idx": 7,
      "start": 14.133,
      "end": 19.167,
      "dur": 5.033,
      "transcript": "pollo, altri chicken tenders e i loro spaghetti. Con contorno di patatine fritte e riso. Ho ovviamente"
    },
    {
      "shot_idx": 8,
      "start": 19.167,
      "end": 23.1,
      "dur": 3.933,
      "transcript": "iniziato provando il loro pollo che era bello caldo, effettivamente molto"
    },
    {
      "shot_idx": 9,
      "start": 23.1,
      "end": 27.933,
      "dur": 4.833,
      "transcript": "croccante e su questo ragazzi non ci piove, anche se a livello puramente di gusto, non mi"
    },
    {
      "shot_idx": 10,
      "start": 27.933,
      "end": 29.5,
      "dur": 1.567,
      "transcript": "ha colpito così tanto. Anche"
    },
    {
      "shot_idx": 11,
      "start": 29.5,
      "end": 31.667,
      "dur": 2.167,
      "transcript": "se siamo comunque su un buon livello di pollo fritto, superiore"
    },
    {
      "shot_idx": 12,
      "start": 31.667,
      "end": 33.6,
      "dur": 1.933,
      "transcript": "KFC, ma forse leggermente inferiore"
    },
    {
      "shot_idx": 13,
      "start": 33.6,
      "end": 35.167,
      "dur": 1.567,
      "transcript": "Popeye's. Dopodiché ho provato il loro"
    },
    {
      "shot_idx": 14,
      "start": 35.167,
      "end": 37.133,
      "dur": 1.967,
      "transcript": "riso che è una palla di riso in bianco, ma molto"
    },
    {
      "shot_idx": 15,
      "start": 37.133,
      "end": 39.167,
      "dur": 2.033,
      "transcript": "buono, si è mangiato con la salsa grella. Patatine che"
    },
    {
      "shot_idx": 16,
      "start": 39.167,
      "end": 41.967,
      "dur": 2.8,
      "transcript": "sono l 'indentiche spiacicate a quelle del McDonald,"
    },
    {
      "shot_idx": 17,
      "start": 41.967,
      "end": 43.933,
      "dur": 1.967,
      "transcript": "almeno qua in Italia. E ho poi proseguito con"
    },
    {
      "shot_idx": 18,
      "start": 43.933,
      "end": 46.033,
      "dur": 2.1,
      "transcript": "quest 'altro pezzone di pollo e finalmente il loro"
    },
    {
      "shot_idx": 19,
      "start": 46.033,
      "end": 47.633,
      "dur": 1.6,
      "transcript": "chicken tenders, che sono state ancora"
    },
    {
      "shot_idx": 20,
      "start": 47.633,
      "end": 50.867,
      "dur": 3.233,
      "transcript": "più croccanti e soprattutto il pollo mi è sembrato un po' più morbido. E da questo punto"
    },
    {
      "shot_idx": 21,
      "start": 50.867,
      "end": 53.833,
      "dur": 2.967,
      "transcript": "era assolutamente arrivato il momento di i loro Jolly Spaghetti. Dei"
    },
    {
      "shot_idx": 22,
      "start": 53.833,
      "end": 57.333,
      "dur": 3.5,
      "transcript": "spaghetti in bianco serviti con una salsa al pomodoro, un Buster"
    },
    {
      "shot_idx": 23,
      "start": 57.333,
      "end": 62.8,
      "dur": 5.467,
      "transcript": "e Cedar grattugiato. Pasto ovviamente stracotte, sapore della salsa che era letteralmente dolce. Cioè ragazzi sembra veramente"
    },
    {
      "shot_idx": 24,
      "start": 62.8,
      "end": 66.067,
      "dur": 3.267,
      "transcript": "di mangiare pasta con il ketchup con il Buster. Una roba davvero indegna"
    },
    {
      "shot_idx": 25,
      "start": 66.067,
      "end": 69.867,
      "dur": 3.8,
      "transcript": "ma molto curiosa, soprattutto perché servite in Italia. Quindi Jolly B apprezzo il"
    },
    {
      "shot_idx": 26,
      "start": 69.867,
      "end": 71.767,
      "dur": 1.9,
      "transcript": "coraggio, ma io resto a federe al vostro pollo."
    },
