      "dur": 1.967,
      "transcript": "risultavano comunque tanto secche. Don lato posso"
    },
    {
      "shot_idx": 10,
      "start": 22.0,
      "end": 24.8,
      "dur": 2.8,
      "transcript": "capirlo perché sono cotto senso olio dall 'altro si poteva fare"
    },
    {
      "shot_idx": 11,
      "start": 24.8,
      "end": 27.767,
      "dur": 2.967,
      "transcript": "sicuramente di più. Passando invece il kebab ho preso il loro kenami con sovraccoce"
    },
