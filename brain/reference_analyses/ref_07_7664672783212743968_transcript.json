    },
    {
      "shot_idx": 6,
      "start": 12.433,
      "end": 15.5,
      "dur": 3.067,
      "transcript": "e le patatine cotti in frigidrice ad aria. Partendo proprio da loro devo"
    },
    {
      "shot_idx": 7,
      "start": 15.5,
      "end": 17.533,
      "dur": 2.033,
      "transcript": "dire che nonostante non mi aspettasse ovviamente la"
    },
