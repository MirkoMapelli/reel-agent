      "shot_idx": 12,
      "start": 27.767,
      "end": 31.267,
      "dur": 3.5,
      "transcript": "di pollo installata a pomodoro. Cipolla, avocado e salsa nami a base"
    },
    {
      "shot_idx": 13,
      "start": 31.267,
      "end": 36.233,
      "dur": 4.967,
      "transcript": "di formaggio proteico lime e rosmarino. E lui sì che era veramente clamoroso. Panino bello grande super"
    },
    {
      "shot_idx": 14,
      "start": 36.233,
      "end": 38.233,
      "dur": 2.0,
      "transcript": "condito cosa che avendo così poche calorie"
    },
