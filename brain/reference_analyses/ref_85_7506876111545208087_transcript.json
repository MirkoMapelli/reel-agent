  "aligned_shots": [
    {
      "shot_idx": 0,
      "start": 0.0,
      "end": 2.0,
      "dur": 2.0,
      "transcript": "La vera pizza nuyorkese finalmente arrivata"
    },
    {
      "shot_idx": 1,
      "start": 2.0,
      "end": 4.5,
      "dur": 2.5,
      "transcript": "a Milano. Oggi ragazzi proviamo pepperoni pizza. La"
    },
    {
      "shot_idx": 2,
      "start": 4.5,
      "end": 6.267,
      "dur": 1.767,
      "transcript": "prima realtà di pizza New York style"
    },
    {
      "shot_idx": 3,
      "start": 6.267,
      "end": 7.867,
      "dur": 1.6,
      "transcript": "aperta appunto a Milano. In zona"
    },
    {
      "shot_idx": 4,
      "start": 7.867,
      "end": 8.833,
      "dur": 0.967,
      "transcript": "Sant 'Ambrogio accanto"
    },
    {
      "shot_idx": 5,
      "start": 8.833,
      "end": 10.033,
      "dur": 1.2,
      "transcript": "all 'università cattolica."
    },
    {
      "shot_idx": 6,
      "start": 10.033,
      "end": 15.833,
      "dur": 5.8,
      "transcript": "Il loro file è molto carino ed è tutto ben brandizzato. E sembra davvero di stare a New York. Noi prima di passare alle slice abbiamo"
    },
    {
      "shot_idx": 7,
      "start": 15.833,
      "end": 16.333,
      "dur": 0.5,
      "transcript": "iniziato con"
    },
    {
      "shot_idx": 8,
      "start": 16.333,
      "end": 19.233,
      "dur": 2.9,
      "transcript": "qualche fritto. Con il loro Mac & Cheese e il loro Nuggets."
    },
    {
      "shot_idx": 9,
      "start": 19.233,
      "end": 21.767,
      "dur": 2.533,
      "transcript": "Intrami con una paratura clamorosa che le"
    },
    {
      "shot_idx": 10,
      "start": 21.767,
      "end": 23.4,
      "dur": 1.633,
      "transcript": "eresi perfettamente croccanti nonostante"
    },
    {
      "shot_idx": 11,
      "start": 23.4,
      "end": 25.6,
      "dur": 2.2,
      "transcript": "comunque dentro che sono morbidissimi. Mac &"
    },
    {
      "shot_idx": 12,
      "start": 25.6,
      "end": 27.067,
      "dur": 1.467,
      "transcript": "Cheese davvero ottimo, molto saporito"
    },
    {
      "shot_idx": 13,
      "start": 27.067,
      "end": 28.333,
      "dur": 1.267,
      "transcript": "e da punto fritto"
    },
    {
      "shot_idx": 14,
      "start": 28.333,
      "end": 30.7,
      "dur": 2.367,
      "transcript": "alla perfezione. Così come i Nuggets fatti proprio con il"
    },
    {
      "shot_idx": 15,
      "start": 30.7,
      "end": 32.3,
      "dur": 1.6,
      "transcript": "filetto di pollo. Passando invece al punto"
    },
    {
      "shot_idx": 16,
      "start": 32.3,
      "end": 34.0,
      "dur": 1.7,
      "transcript": "forte di pepperoni pizza abbiamo appunto"
    },
    {
      "shot_idx": 17,
      "start": 34.0,
      "end": 38.533,
      "dur": 4.533,
      "transcript": "la loro slice. Noi abbiamo provato tre slice diverse. Iniziamo subito da una pepperoni con quattro"
    },
    {
      "shot_idx": 18,
      "start": 38.533,
      "end": 41.033,
      "dur": 2.5,
      "transcript": "formaggi. Una pizza clamorosa cotta"
    },
    {
      "shot_idx": 19,
      "start": 41.033,
      "end": 43.167,
      "dur": 2.133,
      "transcript": "perfettamente. Ovviamente molto saporita,"
    },
    {
      "shot_idx": 20,
      "start": 43.167,
      "end": 45.433,
      "dur": 2.267,
      "transcript": "nonostante comunque i pepperoni sentissero alla grande."
    },
    {
      "shot_idx": 21,
      "start": 45.433,
      "end": 47.667,
      "dur": 2.233,
      "transcript": "Essendo veri i pepperoni quindi 50 %"
    },
    {
      "shot_idx": 22,
      "start": 47.667,
      "end": 52.733,
      "dur": 5.067,
      "transcript": "maiale, 50 % manzo. Per un risultato leggermente speziato, leggermente piccante. Siamo poi passati"
    },
    {
      "shot_idx": 23,
      "start": 52.733,
      "end": 54.9,
      "dur": 2.167,
      "transcript": "alla loro Gliustera e Panapine. Che resta sempre una"
    },
    {
      "shot_idx": 24,
      "start": 54.9,
      "end": 57.533,
      "dur": 2.633,
      "transcript": "pizza devastante. Secondo me è ottimo con questa tipologia di"
    },
    {
      "shot_idx": 25,
      "start": 57.533,
      "end": 60.3,
      "dur": 2.767,
      "transcript": "pizza fatta a slice. Per poi finire con la più classica,"
    },
    {
      "shot_idx": 26,
      "start": 60.3,
      "end": 66.433,
      "dur": 6.133,
      "transcript": "se non forse la migliore di tutto, vero, la classica pepperoni. Una pizza che sa proprio di New York. E che honestamente a me mancava veramente"
    },
    {
      "shot_idx": 27,
      "start": 66.433,
      "end": 69.167,
      "dur": 2.733,
      "transcript": "tanto. Quindi ragazzi che conoscete o meno questa tipologia di"
    },
    {
      "shot_idx": 28,
      "start": 69.167,
      "end": 72.233,
      "dur": 3.067,
      "transcript": "pizza, state a provarla perché davvero clamo, rosa."
    }
