  "aligned_shots": [
    {
      "shot_idx": 0,
      "start": 0.0,
      "end": 2.233,
      "dur": 2.233,
      "transcript": "Il migliore agriturismo della costa Smeralda. Nonché"
    },
    {
      "shot_idx": 1,
      "start": 2.233,
      "end": 4.033,
      "dur": 1.8,
      "transcript": "il migliore porcetto mangiato in costa"
    },
    {
      "shot_idx": 2,
      "start": 4.033,
      "end": 5.633,
      "dur": 1.6,
      "transcript": "Smeralda. Oggi vi portino un agriturismo"
    },
    {
      "shot_idx": 3,
      "start": 5.633,
      "end": 8.633,
      "dur": 3.0,
      "transcript": "un po' meno conosciuto rispetto ai più famosi come Lustazzu, ma"
    },
    {
      "shot_idx": 4,
      "start": 8.633,
      "end": 11.667,
      "dur": 3.033,
      "transcript": "che considero altrettanto valido. Ci troviamo l 'agriturismo Samendula,"
    },
    {
      "shot_idx": 5,
      "start": 11.667,
      "end": 13.667,
      "dur": 2.0,
      "transcript": "vicino Port Rotondo. Partiamo comunque da un"
    },
    {
      "shot_idx": 6,
      "start": 13.667,
      "end": 15.3,
      "dur": 1.633,
      "transcript": "'ottima location ovviamente all 'aperto"
    },
    {
      "shot_idx": 7,
      "start": 15.3,
      "end": 17.233,
      "dur": 1.933,
      "transcript": "con anche un 'ottima vista. Ne lo vamo già una bella"
    },
    {
      "shot_idx": 8,
      "start": 17.233,
      "end": 21.3,
      "dur": 4.067,
      "transcript": "tavolata e ci hanno servito subito il vino della casa. Tempo neanche cinque minuti sono arrivati gli"
    },
    {
      "shot_idx": 9,
      "start": 21.3,
      "end": 23.3,
      "dur": 2.0,
      "transcript": "antipasti con salumi e formaggi accompagnati"
    },
    {
      "shot_idx": 10,
      "start": 23.3,
      "end": 24.6,
      "dur": 1.3,
      "transcript": "da pane e pane carasavo."
    },
    {
      "shot_idx": 11,
      "start": 24.6,
      "end": 25.867,
      "dur": 1.267,
      "transcript": "Ovviamente tutto molto apprezzato,"
    },
    {
      "shot_idx": 12,
      "start": 25.867,
      "end": 27.133,
      "dur": 1.267,
      "transcript": "dopo di che verdure"
    },
    {
      "shot_idx": 13,
      "start": 27.133,
      "end": 29.3,
      "dur": 2.167,
      "transcript": "fritte e delle piccole frittatine di verdure. A"
    },
    {
      "shot_idx": 14,
      "start": 29.3,
      "end": 30.533,
      "dur": 1.233,
      "transcript": "parte altre melanzanne"
    },
    {
      "shot_idx": 15,
      "start": 30.533,
      "end": 32.533,
      "dur": 2.0,
      "transcript": "condite, questa sorta di purè molto"
    },
    {
      "shot_idx": 16,
      "start": 32.533,
      "end": 34.333,
      "dur": 1.8,
      "transcript": "cremoso e con un forte retrogust di"
    },
    {
      "shot_idx": 17,
      "start": 34.333,
      "end": 36.1,
      "dur": 1.767,
      "transcript": "burro e per concludere un assaggio di"
    },
    {
      "shot_idx": 18,
      "start": 36.1,
      "end": 38.1,
      "dur": 2.0,
      "transcript": "cinghiale per tutti. Ma questo era solo l 'antipasto."
    },
    {
      "shot_idx": 19,
      "start": 38.1,
      "end": 40.067,
      "dur": 1.967,
      "transcript": "Passando e prima ovviamente arriviamo alla fregola"
