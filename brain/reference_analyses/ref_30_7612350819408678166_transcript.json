  "aligned_shots": [
    {
      "shot_idx": 0,
      "start": 0.0,
      "end": 3.067,
      "dur": 3.067,
      "transcript": "Il paradiso del senza glutina Milano. Oggi ragazzi siamo da Mama It"
    },
    {
      "shot_idx": 1,
      "start": 3.067,
      "end": 4.533,
      "dur": 1.467,
      "transcript": "che a tutti gli effetti una vera"
    },
    {
      "shot_idx": 2,
      "start": 4.533,
      "end": 6.133,
      "dur": 1.6,
      "transcript": "istituzione del senza glutina e non"
    },
    {
      "shot_idx": 3,
      "start": 6.133,
      "end": 10.4,
      "dur": 4.267,
      "transcript": "solo a Milano ma anche in tutta Italia. Pagliamo di un ristorante con un menu umpissimo tra antipastri fritti"
    },
    {
      "shot_idx": 4,
      "start": 10.4,
      "end": 12.4,
      "dur": 2.0,
      "transcript": "primi secondi ovviamente pizza. Il"
    },
    {
      "shot_idx": 5,
      "start": 12.4,
      "end": 15.033,
      "dur": 2.633,
      "transcript": "tutto ovviamente disponibile anche in gluten -free. Abbiamo iniziato con"
    },
    {
      "shot_idx": 6,
      "start": 15.033,
      "end": 18.667,
      "dur": 3.633,
      "transcript": "degli arancini come antipasto che devo dire essere onesti molto semplici"
    },
    {
      "shot_idx": 7,
      "start": 18.667,
      "end": 20.633,
      "dur": 1.967,
      "transcript": "fritti abbastanza bene con il riso che ha comunque"
    },
    {
      "shot_idx": 8,
      "start": 20.633,
      "end": 23.633,
      "dur": 3.0,
      "transcript": "mantenuto la giusta consistenza e la paracola è bella croccante e dopo di"
    },
    {
      "shot_idx": 9,
      "start": 23.633,
      "end": 26.4,
      "dur": 2.767,
      "transcript": "che i ragazzi voluto provare il loro ripieno fritto. In pratica la"
    },
    {
      "shot_idx": 10,
      "start": 26.4,
      "end": 28.2,
      "dur": 1.8,
      "transcript": "pizza fritta con prosciutto prova la"
    },
    {
      "shot_idx": 11,
      "start": 28.2,
      "end": 30.2,
      "dur": 2.0,
      "transcript": "campana parmigiana ricotta. Impasto che"
    },
    {
      "shot_idx": 12,
      "start": 30.2,
      "end": 32.2,
      "dur": 2.0,
      "transcript": "per essere senza glutina era bello saporito"
    },
    {
      "shot_idx": 13,
      "start": 32.2,
      "end": 34.5,
      "dur": 2.3,
      "transcript": "ma con la frittura è rimasto abbastanza huto e quindi un"
    },
    {
      "shot_idx": 14,
      "start": 34.5,
      "end": 36.933,
      "dur": 2.433,
      "transcript": "filo pesante anche se direi che ordinando una pizza fritta"
    },
    {
      "shot_idx": 15,
      "start": 36.933,
      "end": 38.967,
      "dur": 2.033,
      "transcript": "di certo non ci aspetta una cosa leggera."
    },
    {
      "shot_idx": 16,
      "start": 38.967,
      "end": 40.767,
      "dur": 1.8,
      "transcript": "Dopodiché ho provato la pizza classica ordinando"
    },
    {
      "shot_idx": 17,
      "start": 40.767,
      "end": 43.3,
      "dur": 2.533,
      "transcript": "la rustica ovvero una pizza bianca con mozzarella di"
    },
    {
      "shot_idx": 18,
      "start": 43.3,
      "end": 45.8,
      "dur": 2.5,
      "transcript": "bufala crocchè di patate parmigiano cipolla caramellata."
    },
    {
      "shot_idx": 19,
      "start": 45.8,
      "end": 47.967,
      "dur": 2.167,
      "transcript": "Traciando il fatto che la cipolla non si sentiva"
    },
    {
      "shot_idx": 20,
      "start": 47.967,
      "end": 49.767,
      "dur": 1.8,
      "transcript": "tantissimo devo dire che qui l 'impasto l 'ho sicuramente"
    },
    {
      "shot_idx": 21,
      "start": 49.767,
      "end": 52.133,
      "dur": 2.367,
      "transcript": "preferito rispetto alla pizza fritta e poi resta il fatto che"
    },
    {
      "shot_idx": 22,
      "start": 52.133,
      "end": 54.3,
      "dur": 2.167,
      "transcript": "avere un fritto glutenfree su una pizza non è mai scontato"
    },
    {
      "shot_idx": 23,
      "start": 54.3,
      "end": 56.9,
      "dur": 2.6,
      "transcript": "e tra l 'altro ha provato anche dall 'esperta. Come dolci"
    },
    {
      "shot_idx": 24,
      "start": 56.9,
      "end": 59.433,
      "dur": 2.533,
      "transcript": "non potevano concludere con un tiramisu che nonostante alla vista non"
    },
    {
      "shot_idx": 25,
      "start": 59.433,
      "end": 63.233,
      "dur": 3.8,
      "transcript": "mi ispirasse a livello di sapore davvero uno dei migliori tiramisu provati in un"
    },
    {
      "shot_idx": 26,
      "start": 63.233,
      "end": 64.267,
      "dur": 1.033,
      "transcript": "ristorante a Milano. In conclusione"
    },
    {
      "shot_idx": 27,
      "start": 64.267,
      "end": 69.367,
      "dur": 5.1,
      "transcript": "non la miglior pizza glutenfree che ho provato ma assolutamente un posto da provare se siete cieli acintoleranti."
    },
    {
      "shot_idx": 28,
      "start": 69.367,
      "end": 69.467,
