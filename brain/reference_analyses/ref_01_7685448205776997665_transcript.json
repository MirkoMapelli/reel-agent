  "aligned_shots": [
    {
      "shot_idx": 0,
      "start": 0.0,
      "end": 1.8,
      "dur": 1.8,
      "transcript": "Wings' Top è finalmente arrivato in Italia e"
    },
    {
      "shot_idx": 1,
      "start": 1.8,
      "end": 3.833,
      "dur": 2.033,
      "transcript": "con lui quello che probabilmente sarà anche il"
    },
    {
      "shot_idx": 2,
      "start": 3.833,
      "end": 5.8,
      "dur": 1.967,
      "transcript": "miglior polofetto. Oggi siamo a Milano nel loro"
    },
    {
      "shot_idx": 3,
      "start": 5.8,
      "end": 7.633,
      "dur": 1.833,
      "transcript": "evento di apertura del loro primo storio in"
    },
    {
      "shot_idx": 4,
      "start": 7.633,
      "end": 9.6,
      "dur": 1.967,
      "transcript": "Italia, aperto proprio un viadante 16."
    },
    {
      "shot_idx": 5,
      "start": 9.6,
      "end": 11.367,
      "dur": 1.767,
      "transcript": "Posizione super centrale e location"
    },
    {
      "shot_idx": 6,
      "start": 11.367,
      "end": 13.367,
      "dur": 2.0,
      "transcript": "clamorosa. Noi abbiamo subito ordinato e siamo saliti"
    },
    {
      "shot_idx": 7,
      "start": 13.367,
      "end": 17.333,
      "dur": 3.967,
      "transcript": "al secondo piano dove tra l 'altro c 'era anche il DJ. E questo è tutto ciò che abbiamo preso. Di base"
    },
    {
      "shot_idx": 8,
      "start": 17.333,
      "end": 19.367,
      "dur": 2.033,
      "transcript": "abbiamo preso dei menu combo con 8 Wings"
    },
    {
      "shot_idx": 9,
      "start": 19.367,
      "end": 21.833,
      "dur": 2.467,
      "transcript": "classiche o boneless, retenders, ovviamente"
    },
    {
      "shot_idx": 10,
      "start": 21.833,
      "end": 23.633,
      "dur": 1.8,
      "transcript": "fries e bibita frire fill. E di"
    },
    {
      "shot_idx": 11,
      "start": 23.633,
      "end": 25.4,
      "dur": 1.767,
      "transcript": "ognuno abbiamo dovuto ovviamente scegliere il loro"
    },
    {
      "shot_idx": 12,
      "start": 25.4,
      "end": 28.4,
      "dur": 3.0,
      "transcript": "flavor. Io ho iniziato da queste boneless awaian che è un sapore"
    },
    {
      "shot_idx": 13,
      "start": 28.4,
      "end": 30.867,
      "dur": 2.467,
      "transcript": "molto classico e delicato, che ovviamente fin da subito ha"
    },
    {
      "shot_idx": 14,
      "start": 30.867,
      "end": 33.367,
      "dur": 2.5,
      "transcript": "accompagnato con la loro salsa renna, che è una delle misalze preferite"
    },
    {
      "shot_idx": 15,
      "start": 33.367,
      "end": 35.333,
      "dur": 1.967,
      "transcript": "e col pollo fritto non può mancare. Un po' di fries"
    },
    {
      "shot_idx": 16,
      "start": 35.333,
      "end": 37.333,
      "dur": 2.0,
      "transcript": "col cedar oppure lemon pepper,"
    },
    {
      "shot_idx": 17,
      "start": 37.333,
      "end": 38.867,
      "dur": 1.533,
      "transcript": "anche loro ingiuppate nell 'arence."
    },
    {
      "shot_idx": 18,
      "start": 38.867,
      "end": 40.067,
      "dur": 1.2,
      "transcript": "E ho continuato con questi tender"
    },
    {
      "shot_idx": 19,
      "start": 40.067,
      "end": 41.367,
      "dur": 1.3,
      "transcript": "croccanti super"
    },
    {
      "shot_idx": 20,
      "start": 41.367,
      "end": 42.767,
      "dur": 1.4,
      "transcript": "morbidi all 'interno, ovviamente"
    },
    {
      "shot_idx": 21,
      "start": 42.767,
      "end": 44.767,
      "dur": 2.0,
      "transcript": "anche loro lemon pepper che forse"
    },
    {
      "shot_idx": 22,
      "start": 44.767,
      "end": 47.6,
      "dur": 2.833,
      "transcript": "il mio gusto preferito. In quanto adoro questo leggero pepato e"
    },
    {
      "shot_idx": 23,
      "start": 47.6,
      "end": 49.367,
      "dur": 1.767,
      "transcript": "il sapore di limone un po' grumato. Poi"
    },
    {
      "shot_idx": 24,
      "start": 49.367,
      "end": 51.4,
      "dur": 2.033,
      "transcript": "sono passato alle Wings classiche che anche"
    },
    {
      "shot_idx": 25,
      "start": 51.4,
      "end": 53.5,
      "dur": 2.1,
      "transcript": "se preferisco le boneless loro sono sempre"
    },
    {
      "shot_idx": 26,
      "start": 53.5,
      "end": 55.833,
      "dur": 2.333,
      "transcript": "soddisfacenti da mangiare. Sono tornato su questi"
    },
    {
      "shot_idx": 27,
      "start": 55.833,
      "end": 57.033,
      "dur": 1.2,
      "transcript": "tender super dolci,"
    },
    {
      "shot_idx": 28,
      "start": 57.033,
      "end": 59.033,
      "dur": 2.0,
      "transcript": "ma lo stesso tempo ha fumicati, ovviamente inzuppati"
    },
    {
      "shot_idx": 29,
      "start": 59.033,
      "end": 61.933,
      "dur": 2.9,
      "transcript": "nella salsa renna anche loro. Ho davvero provato quindi un misto di flavor,"
    },
    {
      "shot_idx": 30,
      "start": 61.933,
