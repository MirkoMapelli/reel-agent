  "aligned_shots": [
    {
      "shot_idx": 0,
      "start": 0.0,
      "end": 2.033,
      "dur": 2.033,
      "transcript": "Un fast food di pesce fresco, oggi ragazzi"
    },
    {
      "shot_idx": 1,
      "start": 2.033,
      "end": 4.433,
      "dur": 2.4,
      "transcript": "siamo da Pescaria, a provare i loro nuovi panini del"
    },
    {
      "shot_idx": 2,
      "start": 4.433,
      "end": 8.4,
      "dur": 3.967,
      "transcript": "menu in collaborazione con lo chef da una stella Michelin, Peppe Guida. Pescaria è appunto"
    },
    {
      "shot_idx": 3,
      "start": 8.4,
      "end": 10.6,
      "dur": 2.2,
      "transcript": "una catena di ristoranti che con un format"
    },
    {
      "shot_idx": 4,
      "start": 10.6,
      "end": 14.067,
      "dur": 3.467,
      "transcript": "assimil fast food serve veri e propri piatti e panini con del pesce freschissimo."
    },
    {
      "shot_idx": 5,
      "start": 14.067,
      "end": 17.833,
      "dur": 3.767,
      "transcript": "E questi ragazzi sono in 5 panini che ho provato quest 'oggi. Partendo dal polperone"
    },
    {
      "shot_idx": 6,
      "start": 17.833,
      "end": 20.067,
      "dur": 2.233,
      "transcript": "che è questo panino con polpo fritto, mozzarella"
    },
    {
      "shot_idx": 7,
      "start": 20.067,
      "end": 29.033,
      "dur": 8.967,
      "transcript": "fumicata, pesto di basilico e peperoni conditi con oliva e capperi. Ragazzi, un 'esplosione di sapori con la consenza del polpo fritto perfetta, ovviamente non un panino leggerissimo ma direi che si inizia"
    },
    {
      "shot_idx": 8,
      "start": 29.033,
      "end": 30.633,
      "dur": 1.6,
      "transcript": "col botto. Siamo compassati al"
    },
    {
      "shot_idx": 9,
      "start": 30.633,
      "end": 32.8,
      "dur": 2.167,
      "transcript": "cotoletta di pesce con filetto di merluzzo con panatura"
    },
    {
      "shot_idx": 10,
      "start": 32.8,
      "end": 38.233,
      "dur": 5.433,
      "transcript": "croccante, chips di patate, lattughino, maionese fumé e pesto di basilico. Questo ovviamente con sapori in"
    },
    {
      "shot_idx": 11,
      "start": 38.233,
      "end": 40.533,
      "dur": 2.3,
      "transcript": "realtà più delicati ma assolutamente bilanciati. Come terzo"
    },
    {
      "shot_idx": 12,
      "start": 40.533,
      "end": 42.467,
      "dur": 1.933,
      "transcript": "panino ragazzi arriviamo al mio preferito, il"
    },
    {
      "shot_idx": 13,
      "start": 42.467,
      "end": 45.267,
      "dur": 2.8,
      "transcript": "tatacchi di tonno. Disponibile tra l 'altro ho anche in versione piatto, è"
    },
    {
      "shot_idx": 14,
      "start": 45.267,
      "end": 48.733,
      "dur": 3.467,
      "transcript": "composto da filetto di tonno leggermente piastrato, spinacino condito con"
    },
    {
      "shot_idx": 15,
      "start": 48.733,
      "end": 51.133,
      "dur": 2.4,
      "transcript": "vina greta, maionese e pesto pomodoro secco,"
    },
    {
      "shot_idx": 16,
      "start": 51.133,
      "end": 54.4,
      "dur": 3.267,
      "transcript": "formaggio caprino, pancetta e semi di zucca. Cottura del tonno"
    },
    {
      "shot_idx": 17,
      "start": 54.4,
      "end": 56.9,
      "dur": 2.5,
      "transcript": "perfetta, maionese che insieme la vina greta creavano praticamente una"
    },
    {
      "shot_idx": 18,
      "start": 56.9,
      "end": 60.133,
      "dur": 3.233,
      "transcript": "terza salsa perfetta. Quarto panino abbiamo salmone e capocollo,"
    },
    {
      "shot_idx": 19,
      "start": 60.133,
      "end": 63.3,
      "dur": 3.167,
      "transcript": "che è sicuramente l 'accostamento più strano, ma anche decisamente di noi più"
    },
    {
      "shot_idx": 20,
