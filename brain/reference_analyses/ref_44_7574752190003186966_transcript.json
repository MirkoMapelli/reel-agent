  "aligned_shots": [
    {
      "shot_idx": 0,
      "start": 0.0,
      "end": 2.0,
      "dur": 2.0,
      "transcript": "Una mega pizza gigante,"
    },
    {
      "shot_idx": 1,
      "start": 2.0,
      "end": 4.033,
      "dur": 2.033,
      "transcript": "dei mega pancakes giganti"
    },
    {
      "shot_idx": 2,
      "start": 4.033,
      "end": 8.467,
      "dur": 4.433,
      "transcript": "e una mega ballet nottera gigante. Questa è la America ragazzi, oggi vi porto come una giornata"
    },
    {
      "shot_idx": 3,
      "start": 8.467,
      "end": 11.0,
      "dur": 2.533,
      "transcript": "a Monteray, in California. Giornata che è chiaramente"
    },
    {
      "shot_idx": 4,
      "start": 11.0,
      "end": 12.967,
      "dur": 1.967,
      "transcript": "partita con un caffettone"
    },
    {
      "shot_idx": 5,
      "start": 12.967,
      "end": 19.433,
      "dur": 6.467,
      "transcript": "americano. E con un giretto in questa città, durante il quale ci sono imbatuti in queste centinaia. Sono migliaia di foche, leone di mare."
    },
    {
      "shot_idx": 6,
      "start": 19.433,
      "end": 23.967,
      "dur": 4.533,
      "transcript": ""
    },
    {
      "shot_idx": 7,
      "start": 23.967,
      "end": 28.5,
      "dur": 4.533,
      "transcript": "Dopodiché ragazzi però c 'è venuto a fare, noi quindi siamo andati a fare un branco in uno dei diner più famosi della città."
    },
    {
      "shot_idx": 8,
      "start": 28.5,
      "end": 30.433,
      "dur": 1.933,
      "transcript": "Dove ho preso questa sorta di club sandwich"
    },
    {
      "shot_idx": 9,
      "start": 30.433,
      "end": 33.467,
      "dur": 3.033,
      "transcript": "con patate e queste altre mega pancakes alla banana e"
    },
    {
      "shot_idx": 10,
      "start": 33.467,
      "end": 37.933,
      "dur": 4.467,
      "transcript": "nuoci con cioccolato e burro. Partendo dal sandwich ragazzi guardate quanti strati c 'erano. Prosciutto"
    },
    {
      "shot_idx": 11,
      "start": 37.933,
      "end": 42.3,
      "dur": 4.367,
      "transcript": "beh con insalata, pomodori, ala pegno, formaggio chissà cos 'altro. Buono eh, ma la"
    },
    {
      "shot_idx": 12,
      "start": 42.3,
      "end": 43.933,
      "dur": 1.633,
      "transcript": "morbidezza di questi pancakes alla banana"
    },
    {
      "shot_idx": 13,
      "start": 43.933,
      "end": 45.967,
      "dur": 2.033,
      "transcript": "e nuoci è stata insuperabile. E subito dopo"
    },
    {
      "shot_idx": 14,
      "start": 45.967,
      "end": 48.1,
      "dur": 2.133,
      "transcript": "nel pomeriggio... Mamma mia!"
    },
    {
      "shot_idx": 15,
      "start": 48.1,
      "end": 62.933,
      "dur": 14.833,
      "transcript": "Whale watching a largo delle coste di Monteray. Dove siamo riusciti ad avvistare queste 3 -4 ballene? All 'inizio un po' più lontananza e alla fine anche ben da vicino. Che ci hanno regalato uno spettacolo unico e clamoroso che tra l 'altro non avevo mai visto in tutta la mia vita. E da proposito"
    },
    {
      "shot_idx": 16,
      "start": 62.933,
      "end": 65.9,
      "dur": 2.967,
      "transcript": "di esperdienze clamorose per cena non potevo non concludere questa"
    },
    {
      "shot_idx": 17,
      "start": 65.9,
      "end": 68.367,
      "dur": 2.467,
      "transcript": "giornata con una pizza clamorosa. Pepperoni"
    },
    {
      "shot_idx": 18,
      "start": 68.367,
      "end": 75.2,
      "dur": 6.833,
      "transcript": "pizza presa da Monty Mike's Pizza che ragazzi mi ha stupito veramente tanto. Giuticandola chiaramente come pizza americana, davvero una"
    },
    {
      "shot_idx": 19,
      "start": 75.2,
      "end": 77.2,
      "dur": 2.0,
      "transcript": "delle migliori mai mangiate contro l 'altro dei"
    },
    {
      "shot_idx": 20,
      "start": 77.2,
      "end": 81.6,
      "dur": 4.4,
      "transcript": "pepperoni super croccanti esattamente come dovrebbero essere i pepperoni americani."
    }
  ]
