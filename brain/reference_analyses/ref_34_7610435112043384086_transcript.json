  "aligned_shots": [
    {
      "shot_idx": 0,
      "start": 0.0,
      "end": 2.0,
      "dur": 2.0,
      "transcript": "Una pizza di mare con scampia, lapegno,"
    },
    {
      "shot_idx": 1,
      "start": 2.0,
      "end": 3.967,
      "dur": 1.967,
      "transcript": "gigante e uno spaghetto affumicato,"
    },
    {
      "shot_idx": 2,
      "start": 3.967,
      "end": 5.8,
      "dur": 1.833,
      "transcript": "allastici e davvero clamoroso. Oggi ragazzi"
    },
    {
      "shot_idx": 3,
      "start": 5.8,
      "end": 6.967,
      "dur": 1.167,
      "transcript": "vi porto con me in questa cena"
    },
    {
      "shot_idx": 4,
      "start": 6.967,
      "end": 8.4,
      "dur": 1.433,
      "transcript": "da Nina, trattoria e pizzeria di"
    },
    {
      "shot_idx": 5,
      "start": 8.4,
      "end": 10.233,
      "dur": 1.833,
      "transcript": "mare. Lo chicio in caraibica, molto"
    },
    {
      "shot_idx": 6,
      "start": 10.233,
      "end": 14.033,
      "dur": 3.8,
      "transcript": "ben tematizzata e molto carino. Noi abbiamo iniziato provando questi 50 pasti"
    },
    {
      "shot_idx": 7,
      "start": 14.033,
      "end": 15.633,
      "dur": 1.6,
      "transcript": "tendo al più delicato con questo"
    },
    {
      "shot_idx": 8,
      "start": 15.633,
      "end": 17.0,
      "dur": 1.367,
      "transcript": "carpaccio di ricciola."
    },
    {
      "shot_idx": 9,
      "start": 17.0,
      "end": 18.867,
      "dur": 1.867,
      "transcript": "Consiedano oliveta jascha e pecorino,"
    },
    {
      "shot_idx": 10,
      "start": 18.867,
      "end": 19.833,
      "dur": 0.967,
      "transcript": "davvero un ottimo accostamento."
    },
    {
      "shot_idx": 11,
      "start": 19.833,
      "end": 21.233,
      "dur": 1.4,
      "transcript": "Ho proseguito con questi"
    },
    {
      "shot_idx": 12,
      "start": 21.233,
      "end": 22.4,
      "dur": 1.167,
      "transcript": "gambri alla catalana, super"
    },
    {
      "shot_idx": 13,
      "start": 22.4,
      "end": 23.767,
      "dur": 1.367,
      "transcript": "freschi, poi polpe"
    },
    {
      "shot_idx": 14,
      "start": 23.767,
      "end": 24.933,
      "dur": 1.167,
      "transcript": "patate con anche pomodorini"
    },
    {
      "shot_idx": 15,
      "start": 24.933,
      "end": 26.4,
      "dur": 1.467,
      "transcript": "al basilico e olive."
    },
    {
      "shot_idx": 16,
      "start": 26.4,
      "end": 27.633,
      "dur": 1.233,
      "transcript": "Ho assaggiato la loro frisella"
    },
    {
      "shot_idx": 17,
      "start": 27.633,
      "end": 29.233,
      "dur": 1.6,
      "transcript": "con pomodorini datterini,"
    },
    {
      "shot_idx": 18,
      "start": 29.233,
      "end": 30.4,
      "dur": 1.167,
      "transcript": "caccia ricotta"
    },
    {
      "shot_idx": 19,
      "start": 30.4,
      "end": 31.767,
      "dur": 1.367,
      "transcript": "e gambri rossi"
    },
    {
      "shot_idx": 20,
      "start": 31.767,
      "end": 33.567,
      "dur": 1.8,
      "transcript": "marinati. E come ultimo anti -pasto, questi"
    },
    {
      "shot_idx": 21,
      "start": 33.567,
      "end": 36.3,
      "dur": 2.733,
      "transcript": "polipetti alla luce hanno una con crema di patate, che è personalmente davvero"
    },
    {
      "shot_idx": 22,
      "start": 36.3,
      "end": 38.0,
      "dur": 1.7,
      "transcript": "adorato. Passando ai piatti principali"
    },
    {
      "shot_idx": 23,
      "start": 38.0,
      "end": 40.2,
      "dur": 2.2,
      "transcript": "abbiamo questo spaghetto leggermente affumicato"
    },
    {
      "shot_idx": 24,
      "start": 40.2,
      "end": 42.8,
      "dur": 2.6,
      "transcript": "con l 'astice e questa pizza appunto con"
    },
    {
      "shot_idx": 25,
      "start": 42.8,
      "end": 44.567,
      "dur": 1.767,
      "transcript": "scampi, ala pegno e pomodorini."
    },
    {
      "shot_idx": 26,
      "start": 44.567,
      "end": 47.6,
      "dur": 3.033,
      "transcript": "Spaghetto che era un po' più scuro, a causa della leggera affumicatura che gli"
    },
    {
      "shot_idx": 27,
      "start": 47.6,
      "end": 50.233,
      "dur": 2.633,
      "transcript": "reso un po' più saporiti. Tra l 'altro ragazzi porzione davvero"
    },
    {
      "shot_idx": 28,
      "start": 50.233,
      "end": 52.2,
      "dur": 1.967,
      "transcript": "abbondante sia per gli spaghetti che per il sugo"
    },
    {
      "shot_idx": 29,
      "start": 52.2,
      "end": 54.767,
      "dur": 2.567,
      "transcript": "allastice. Mi è piaciuto parecchio. Pizza che invece ha ovviamente"
    },
    {
      "shot_idx": 30,
      "start": 54.767,
      "end": 56.8,
      "dur": 2.033,
      "transcript": "un accostamento molto particolare ed un impasto"
    },
    {
      "shot_idx": 31,
      "start": 56.8,
      "end": 58.4,
      "dur": 1.6,
      "transcript": "leggero sottile e davvero ben"
    },
    {
      "shot_idx": 32,
      "start": 58.4,
      "end": 59.833,
      "dur": 1.433,
      "transcript": "teso tanto da renderla gigante."
    },
    {
      "shot_idx": 33,
      "start": 59.833,
      "end": 62.033,
      "dur": 2.2,
      "transcript": "Con alla base una crema di pomodorini gialli,"
    },
    {
      "shot_idx": 34,
      "start": 62.033,
      "end": 63.5,
      "dur": 1.467,
      "transcript": "fioridatta affumicato che dà una bella"
    },
    {
      "shot_idx": 35,
      "start": 63.5,
      "end": 64.867,
      "dur": 1.367,
      "transcript": "spinta e poi l 'ottimo costamento"
    },
    {
      "shot_idx": 36,
      "start": 64.867,
      "end": 66.833,
      "dur": 1.967,
      "transcript": "di sapori molto forti tra scampi e"
    },
    {
      "shot_idx": 37,
      "start": 66.833,
      "end": 68.867,
      "dur": 2.033,
      "transcript": "ala pegno. Dopodiché non potevamo non"
    },
    {
      "shot_idx": 38,
      "start": 68.867,
      "end": 70.1,
      "dur": 1.233,
      "transcript": "provare il loro frittomisto."
    },
    {
      "shot_idx": 39,
      "start": 70.1,
      "end": 71.267,
      "dur": 1.167,
      "transcript": "Anche se era la porzione per"
    },
    {
      "shot_idx": 40,
      "start": 71.267,
      "end": 72.867,
      "dur": 1.6,
      "transcript": "uno era davvero abbondante. Contrattro"
    },
    {
      "shot_idx": 41,
      "start": 72.867,
      "end": 74.833,
      "dur": 1.967,
      "transcript": "ho anche un granchio a suo interno. E di infine per concludere"
    },
    {
      "shot_idx": 42,
      "start": 74.833,
      "end": 77.2,
      "dur": 2.367,
      "transcript": "questa cena abbiamo della frutta ripiena al suo interno"
    },
    {
      "shot_idx": 43,
      "start": 77.2,
      "end": 79.167,
      "dur": 1.967,
      "transcript": "del gelato o del gusto stesso del frutto."
    },
    {
      "shot_idx": 44,
      "start": 79.167,
      "end": 80.567,
      "dur": 1.4,
      "transcript": "Insomma davvero un ottimo locale"
    },
    {
      "shot_idx": 45,
      "start": 80.567,
      "end": 82.433,
      "dur": 1.867,
      "transcript": "per provare la vera cucina di mare."
    }
