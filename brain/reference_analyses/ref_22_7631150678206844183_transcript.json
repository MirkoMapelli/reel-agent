  "aligned_shots": [
    {
      "shot_idx": 0,
      "start": 0.0,
      "end": 2.5,
      "dur": 2.5,
      "transcript": "Un nuovo smashburger a Milano? Oggi ragazzi proviamo"
    },
    {
      "shot_idx": 1,
      "start": 2.5,
      "end": 3.933,
      "dur": 1.433,
      "transcript": "Smashers. Un locale che ha da poco"
    },
    {
      "shot_idx": 2,
      "start": 3.933,
      "end": 5.7,
      "dur": 1.767,
      "transcript": "aperto la sua prima seda Milano in corso"
    },
    {
      "shot_idx": 3,
      "start": 5.7,
      "end": 7.467,
      "dur": 1.767,
      "transcript": "Buenos Aires. Menù molto semplice con"
    },
    {
      "shot_idx": 4,
      "start": 7.467,
      "end": 9.433,
      "dur": 1.967,
      "transcript": "veramente quattro panini, patatine e"
    },
    {
      "shot_idx": 5,
      "start": 9.433,
      "end": 10.6,
      "dur": 1.167,
      "transcript": "nuggets. Ed ecco qua il mio"
    },
    {
      "shot_idx": 6,
      "start": 10.6,
      "end": 11.567,
      "dur": 0.967,
      "transcript": "sacchetto col mio ordine."
    },
    {
      "shot_idx": 7,
      "start": 11.567,
      "end": 12.733,
      "dur": 1.167,
      "transcript": "Partiamo con l 'assaggio dei loro"
    },
    {
      "shot_idx": 8,
      "start": 12.733,
      "end": 13.6,
      "dur": 0.867,
      "transcript": "nuggets che mi hanno"
    },
    {
      "shot_idx": 9,
      "start": 13.6,
      "end": 14.767,
      "dur": 1.167,
      "transcript": "davvero stupito. Perché essendo"
    },
    {
      "shot_idx": 10,
      "start": 14.767,
      "end": 19.733,
      "dur": 4.967,
      "transcript": "io interessato al loro smashburger avevo un po' sottovalutato questo prodotto. Invece avevano questa panatura super croccante"
    },
    {
      "shot_idx": 11,
      "start": 19.733,
      "end": 22.2,
      "dur": 2.467,
      "transcript": "e all 'interno si vedeva che era comunque filetto di bollo."
    },
    {
      "shot_idx": 12,
      "start": 22.2,
      "end": 24.233,
      "dur": 2.033,
      "transcript": "Ragazzi davvero tanta robe ovviamente perfetti da"
    },
    {
      "shot_idx": 13,
      "start": 24.233,
      "end": 26.167,
      "dur": 1.933,
      "transcript": "accompagnare ad uno smashers. Da proposito di ciò"
    },
    {
      "shot_idx": 14,
      "start": 26.167,
      "end": 27.8,
      "dur": 1.633,
      "transcript": "proviamo l 'Orchish Burger. Quindi un panino molto"
    },
    {
      "shot_idx": 15,
      "start": 27.8,
      "end": 30.0,
      "dur": 2.2,
      "transcript": "semplice con doppio patty, cheddar e"
    },
    {
      "shot_idx": 16,
      "start": 30.0,
      "end": 33.567,
      "dur": 3.567,
      "transcript": "salsa secret. Il tutto era chiuso in un banner che era piuttosto morbido. All 'aspetto"
    },
    {
      "shot_idx": 17,
      "start": 33.567,
      "end": 35.167,
      "dur": 1.6,
      "transcript": "dire che si presenta molto bene così"
    },
    {
      "shot_idx": 18,
      "start": 35.167,
      "end": 37.2,
      "dur": 2.033,
      "transcript": "come i patti che erano effettivamente smashati"
    },
    {
      "shot_idx": 19,
      "start": 37.2,
      "end": 38.267,
      "dur": 1.067,
      "transcript": "alla grande. Rostecina presente"
    },
    {
      "shot_idx": 20,
      "start": 38.267,
      "end": 40.267,
      "dur": 2.0,
      "transcript": "e comunque su cosità della carne che"
    },
    {
      "shot_idx": 21,
      "start": 40.267,
      "end": 42.033,
      "dur": 1.767,
      "transcript": "non si perdono nonostante la smashata."
    },
    {
      "shot_idx": 22,
      "start": 42.033,
      "end": 43.633,
      "dur": 1.6,
      "transcript": "E salsa secret che è effettivamente il"
    },
    {
      "shot_idx": 23,
      "start": 43.633,
      "end": 46.667,
      "dur": 3.033,
      "transcript": "segreto di questo cheeseburger. Insomma un panino molto semplice con pochi ingredienti"
    },
    {
      "shot_idx": 24,
      "start": 46.667,
      "end": 48.3,
      "dur": 1.633,
      "transcript": "ma tutti ben fatti ed è proprio qua che"
    },
    {
      "shot_idx": 25,
      "start": 48.3,
      "end": 50.233,
      "dur": 1.933,
      "transcript": "la semplicità vinge. Ed infine passando alle"
    },
    {
      "shot_idx": 26,
      "start": 50.233,
      "end": 52.267,
      "dur": 2.033,
      "transcript": "loro patatine che normalmente non apprezzo mai"
    },
    {
      "shot_idx": 27,
      "start": 52.267,
      "end": 54.033,
      "dur": 1.767,
      "transcript": "particolarmente. Beh questa volta anche"
    },
    {
      "shot_idx": 28,
      "start": 54.033,
      "end": 57.233,
      "dur": 3.2,
      "transcript": "qui mi sono ricreduto. In quanto fritta alla grande e soprattutto con la buccia che"
    },
    {
      "shot_idx": 29,
      "start": 57.233,
      "end": 58.933,
      "dur": 1.7,
      "transcript": "quel tocco in più che mi piace sempre. Quindi"
    },
    {
      "shot_idx": 30,
      "start": 58.933,
      "end": 61.9,
      "dur": 2.967,
      "transcript": "ragazzi se vi piacciono gli smashburger passate da smashers ma non dimenticatevi"
    },
    {
      "shot_idx": 31,
      "start": 61.9,
      "end": 63.9,
      "dur": 2.0,
      "transcript": "dei loro nagezza e delle loro fries."
    }
