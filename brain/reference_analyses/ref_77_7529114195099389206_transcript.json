      "dur": 0.667,
      "transcript": "immersi"
    },
    {
      "shot_idx": 2,
      "start": 1.633,
      "end": 3.733,
      "dur": 2.1,
      "transcript": "nella natura di un frutteto. Oggi, ragazzi, vi"
    },
    {
      "shot_idx": 3,
      "start": 3.733,
      "end": 7.233,
      "dur": 3.5,
      "transcript": "porto da Cascina Pizzo per mostrarvi la loro formula peritivo che potete"
    },
    {
      "shot_idx": 4,
      "start": 7.233,
      "end": 10.233,
      "dur": 3.0,
      "transcript": "fare in questi tavolini proprio in mezzo al frutteto. Una volta arrivati,"
    },
    {
      "shot_idx": 5,
      "start": 10.233,
      "end": 11.2,
      "dur": 0.967,
      "transcript": "vi deranno il vostro"
    },
    {
      "shot_idx": 6,
      "start": 11.2,
      "end": 11.833,
      "dur": 0.633,
      "transcript": "cestino contenente"
    },
    {
      "shot_idx": 7,
      "start": 11.833,
      "end": 13.433,
      "dur": 1.6,
      "transcript": "del pane, dei taralli,"
    },
    {
      "shot_idx": 8,
      "start": 13.433,
      "end": 15.833,
      "dur": 2.4,
      "transcript": "entrambi con anche opzioni senza glutine, della frutta"
    },
    {
      "shot_idx": 9,
      "start": 15.833,
      "end": 18.2,
      "dur": 2.367,
      "transcript": "di pomodorini, due salamieni, una forma di"
    },
    {
      "shot_idx": 10,
      "start": 18.2,
      "end": 21.633,
      "dur": 3.433,
      "transcript": "formaggio e una composta artigianale di mele, con anche ovviamente la possibilità di"
    },
    {
      "shot_idx": 11,
      "start": 21.633,
      "end": 23.633,
      "dur": 2.0,
      "transcript": "accompagnare il tutto con un calice o una"
    },
    {
      "shot_idx": 12,
      "start": 23.633,
      "end": 25.667,
      "dur": 2.033,
      "transcript": "bottiglia di vino. Una formula in realtà abbastanza"
    },
    {
      "shot_idx": 13,
      "start": 25.667,
      "end": 27.667,
      "dur": 2.0,
      "transcript": "semplice con prodotti comunque locali e davvero"
    },
    {
      "shot_idx": 14,
      "start": 27.667,
      "end": 29.7,
      "dur": 2.033,
      "transcript": "di qualità, che io devo mettere che ho particolarmente"
    },
    {
      "shot_idx": 15,
      "start": 29.7,
      "end": 32.033,
      "dur": 2.333,
      "transcript": "apprezzato, visto che tre panini con il salame"
    },
    {
      "shot_idx": 16,
      "start": 32.033,
      "end": 34.5,
      "dur": 2.467,
      "transcript": "e l 'accostamento con la composta di frutta mi sono quasi"
    },
    {
      "shot_idx": 17,
      "start": 34.5,
      "end": 35.233,
      "dur": 0.733,
      "transcript": "fatto fuori tutta"
    },
    {
      "shot_idx": 18,
      "start": 35.233,
      "end": 38.033,
      "dur": 2.8,
      "transcript": "quella mezza forma di formaggio, il tutto con una location piuttosto"
    },
    {
      "shot_idx": 19,
      "start": 38.033,
      "end": 39.567,
      "dur": 1.533,
      "transcript": "inusuale ma molto molto"
