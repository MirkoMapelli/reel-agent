  "segments": [
    {
      "start": 0.0,
      "end": 6.14,
      "text": "Proviamo il nuovo menu gluten free di all dwell west tante nuove proposte senza glutine che potete trovare in tantissimi dei loro stor"
    },
    {
      "start": 6.14,
      "end": 12.2,
      "text": "Iniziamo degli appetizer provando il loro nuggets di pollo serviti con l'iconica salsa all dwell west panatura gluten free"
    },
    {
      "start": 12.2,
      "end": 19.02,
      "text": "super croccante ed uguali ai classici nuggets davvero davvero buoni grazie anche all'iconica salsa passiamo ora al bacon cheddar burger"
    },
    {
      "start": 19.02,
      "end": 26.44,
      "text": "con ovviamente hamburger cheddar fuso pomodori un salata ketchup e beccone e procediamo quindi col test test di questo burger carne davvero davvero"
    },
    {
      "start": 26.44,
      "end": 30.68,
      "text": "Buona e pane super morbido e croccante tanto da non distingue lo dò un panino classico"
    },
    {
      "start": 30.68,
      "end": 34.68,
      "text": "Ho poi fatto assaggiare questo panino un'altra persona non ce li ha capo di sapere cosa ne pensasse"
    },
    {
      "start": 34.68,
      "end": 39.16,
      "text": "da non ce li ha col pane davvero ottimo ed è identico al pane col gluten"
    },
    {
      "start": 39.16,
      "end": 44.08,
      "text": "test test anche della rodeo steak ovvero la tagliata di filetto alla griglia con rucola"
    },
    {
      "start": 44.08,
      "end": 51.66,
      "text": "patatini e fritte e salsa all dwell west cottura della carne davvero perfetta con la parte centrale della tagliata che davvero si scioglieva in bocca"
    },
    {
      "start": 51.66,
      "end": 59.02,
      "text": "patatini salsa che chiaramente sono la combo perfetta e per concludere mini ice cookies e mini ice alla fragola ovviamente anche essi senza glutine"
    },
    {
      "start": 59.02,
      "end": 64.6,
      "text": "un'ottima iniziativa che vi permette di avere a disposizione un ampio menu certificato senza glutine senza rinunciare il gusto"
    }
  ],
