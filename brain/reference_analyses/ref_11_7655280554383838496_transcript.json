    },
    {
      "shot_idx": 2,
      "start": 3.667,
      "end": 4.467,
      "dur": 0.8,
      "transcript": "perché sì ragazzi"
    },
    {
      "shot_idx": 3,
      "start": 4.467,
      "end": 7.1,
      "dur": 2.633,
      "transcript": "qua stiamo parlando tutti gli effetti di un paradiso, a"
    },
    {
      "shot_idx": 4,
      "start": 7.1,
      "end": 8.567,
      "dur": 1.467,
      "transcript": "partire proprio da questa corazione"
    },
    {
      "shot_idx": 5,
      "start": 8.567,
      "end": 10.067,
      "dur": 1.5,
      "transcript": "con un omelette fatta sul momento"
    },
    {
      "shot_idx": 6,
      "start": 10.067,
      "end": 13.1,
      "dur": 3.033,
      "transcript": "vista mare che come inizio possiamo già dire che erasenta la"
    },
    {
      "shot_idx": 7,
      "start": 13.1,
      "end": 14.4,
      "dur": 1.3,
      "transcript": "perfezione, dopo di che in"
    },
    {
      "shot_idx": 8,
      "start": 14.4,
      "end": 16.2,
      "dur": 1.8,
      "transcript": "mattina sono stato un po' tra mare"
    },
    {
      "shot_idx": 9,
      "start": 16.2,
      "end": 18.033,
      "dur": 1.833,
      "transcript": "e piscina per poi tornare"
    },
    {
      "shot_idx": 10,
      "start": 18.033,
      "end": 19.4,
      "dur": 1.367,
      "transcript": "a ricaricare l 'energia con il"
    },
    {
      "shot_idx": 11,
      "start": 19.4,
      "end": 20.7,
      "dur": 1.3,
      "transcript": "nostro pranzo dopo aver provato"
    },
    {
      "shot_idx": 12,
      "start": 20.7,
      "end": 22.233,
      "dur": 1.533,
      "transcript": "un po' di gerire siamo ripartiti"
    },
    {
      "shot_idx": 13,
      "start": 22.233,
      "end": 24.067,
      "dur": 1.833,
      "transcript": "in barca come il giorno precedente ma questa"
    },
    {
      "shot_idx": 14,
      "start": 24.067,
      "end": 24.567,
      "dur": 0.5,
      "transcript": "volta alla"
    },
    {
      "shot_idx": 15,
      "start": 24.567,
      "end": 25.4,
      "dur": 0.833,
      "transcript": "ricerca della"
    },
    {
      "shot_idx": 16,
      "start": 25.4,
      "end": 26.433,
      "dur": 1.033,
      "transcript": "Tartaluga Marina e anche"
    },
    {
      "shot_idx": 17,
      "start": 26.433,
      "end": 29.4,
      "dur": 2.967,
      "transcript": "in questo caso siamo stati piuttosto fortunati perché ne abbiamo subito trovate"
    },
    {
      "shot_idx": 18,
      "start": 29.4,
      "end": 31.867,
      "dur": 2.467,
      "transcript": "un paio e ci siamo quindi immersi per notarci accanto"
    },
    {
      "shot_idx": 19,
      "start": 31.867,
      "end": 34.433,
      "dur": 2.567,
      "transcript": "ovviamente nonostante qualche piccolo momento in cui ci siamo"
    },
    {
      "shot_idx": 20,
      "start": 34.433,
      "end": 39.433,
      "dur": 5.0,
      "transcript": "avvicinati tanto non le abbiamo mai toccate questo per non darle troppo fastidio, cosa che è molto importante nonostante comunque"
    },
    {
      "shot_idx": 21,
      "start": 39.433,
      "end": 41.933,
      "dur": 2.5,
      "transcript": "possono abbastanza vicini anche questa volta incontrare un"
    },
    {
      "shot_idx": 22,
      "start": 41.933,
      "end": 43.733,
      "dur": 1.8,
      "transcript": "animale del genere in mare aperto"
    },
    {
      "shot_idx": 23,
      "start": 43.733,
      "end": 45.9,
      "dur": 2.167,
      "transcript": "è davvero qualcosa di clavo, molto prozzo,"
    },
    {
      "shot_idx": 24,
      "start": 45.9,
      "end": 47.867,
      "dur": 1.967,
      "transcript": "abbiamo proseguito il giro andando a visitare"
    },
    {
      "shot_idx": 25,
      "start": 47.867,
      "end": 50.7,
      "dur": 2.833,
      "transcript": "anche questo relito che per me è diventata la casa di migliaia di"
    },
    {
      "shot_idx": 26,
      "start": 50.7,
      "end": 52.5,
      "dur": 1.8,
      "transcript": "pesci incontrando anche una carinissima"
    },
    {
      "shot_idx": 27,
      "start": 52.5,
      "end": 54.267,
      "dur": 1.767,
      "transcript": "razza, tornati poi al villaggio abbiamo"
    },
    {
      "shot_idx": 28,
      "start": 54.267,
      "end": 56.0,
      "dur": 1.733,
      "transcript": "fatto una bella partita di paddel che è sempre"
    },
    {
      "shot_idx": 29,
      "start": 56.0,
      "end": 58.0,
      "dur": 2.0,
      "transcript": "divertente nonostante 40 gradi, tramonto"
    },
    {
      "shot_idx": 30,
      "start": 58.0,
      "end": 59.7,
      "dur": 1.7,
      "transcript": "sulla spiaggia e poi cena"
    },
    {
      "shot_idx": 31,
      "start": 59.7,
      "end": 61.467,
      "dur": 1.767,
      "transcript": "tra l 'altro oggi era la serata a Tartaluaida,"
    },
    {
      "shot_idx": 32,
      "start": 61.467,
      "end": 63.1,
      "dur": 1.633,
      "transcript": "io ho iniziato da questo carpaccio"
    },
    {
      "shot_idx": 33,
      "start": 63.1,
      "end": 65.2,
      "dur": 2.1,
      "transcript": "tagliato al momento ed a buon italiano doppia"
    },
    {
      "shot_idx": 34,
      "start": 65.2,
      "end": 66.933,
      "dur": 1.733,
      "transcript": "porzione di pasta poi un giro"
    },
    {
      "shot_idx": 35,
      "start": 66.933,
      "end": 68.433,
      "dur": 1.5,
      "transcript": "veloce dei secondi e ovviamente"
