    {
      "shot_idx": 2,
      "start": 3.633,
      "end": 5.467,
      "dur": 1.833,
      "transcript": "vi porto a provare Capuanos. Una pizzeria"
    },
    {
      "shot_idx": 3,
      "start": 5.467,
      "end": 7.533,
      "dur": 2.067,
      "transcript": "napoletana con più sedi che rappresenta al"
    },
    {
      "shot_idx": 4,
      "start": 7.533,
      "end": 9.567,
      "dur": 2.033,
      "transcript": "massimo la tradizione di Napoli. Noi abbiamo"
    },
    {
      "shot_idx": 5,
      "start": 9.567,
      "end": 11.2,
      "dur": 1.633,
      "transcript": "ovviamente iniziato a col Capuanos"
    },
    {
      "shot_idx": 6,
      "start": 11.2,
      "end": 13.2,
      "dur": 2.0,
      "transcript": "Grand Fritto Napoli, che è quindi un misto di"
    },
    {
      "shot_idx": 7,
      "start": 13.2,
      "end": 14.667,
      "dur": 1.467,
      "transcript": "fritti napoletani che ci ha permesso"
    },
    {
      "shot_idx": 8,
      "start": 14.667,
      "end": 16.433,
      "dur": 1.767,
      "transcript": "di provare le loro montanarine,"
    },
    {
      "shot_idx": 9,
      "start": 16.433,
      "end": 17.633,
      "dur": 1.2,
      "transcript": "super buone e fresche col"
    },
    {
      "shot_idx": 10,
      "start": 17.633,
      "end": 19.167,
      "dur": 1.533,
      "transcript": "pomodoro, i croquet di patate che"
    },
    {
      "shot_idx": 11,
      "start": 19.167,
      "end": 22.167,
      "dur": 3.0,
      "transcript": "erano davvero davvero filanti come potete ben vedere, e che proprio"
    },
    {
      "shot_idx": 12,
      "start": 22.167,
      "end": 25.967,
      "dur": 3.8,
      "transcript": "per questo mi hanno stupito parecchio, poi un po' di zeppoline alle erbe e gli arancini"
    },
    {
      "shot_idx": 13,
      "start": 25.967,
      "end": 27.767,
      "dur": 1.8,
      "transcript": "di riso, che nonostante gli erbe assaggiati"
    },
    {
      "shot_idx": 14,
      "start": 27.767,
      "end": 30.067,
      "dur": 2.3,
      "transcript": "per ultimi devo dire che si sono mantenuti bene. Dopodiché"
    },
    {
      "shot_idx": 15,
      "start": 30.067,
      "end": 31.9,
      "dur": 1.833,
      "transcript": "si hanno passati alle pizze con la"
    },
    {
      "shot_idx": 16,
      "start": 31.9,
      "end": 34.367,
      "dur": 2.467,
      "transcript": "San Marzano, che è una pizza con pomodoro San Marzano,"
    },
    {
      "shot_idx": 17,
      "start": 34.367,
      "end": 36.533,
      "dur": 2.167,
      "transcript": "provola fumicata di agerola, provolone del"
    },
    {
      "shot_idx": 18,
      "start": 36.533,
      "end": 37.567,
      "dur": 1.033,
      "transcript": "Monaco e al"
    },
    {
      "shot_idx": 19,
      "start": 37.567,
      "end": 39.733,
      "dur": 2.167,
      "transcript": "centro questa mega burrata fritta, che aveva"
    },
    {
      "shot_idx": 20,
      "start": 39.733,
      "end": 41.233,
      "dur": 1.5,
      "transcript": "appunto questa fumicatura che le ha reso"
    },
    {
      "shot_idx": 21,
      "start": 41.233,
      "end": 44.7,
      "dur": 3.467,
      "transcript": "ancora più saporita della burrata classica e che ha mantenuto questa consistenza"
    },
    {
      "shot_idx": 22,
      "start": 44.7,
      "end": 46.9,
      "dur": 2.2,
      "transcript": "morbida dentro ma croccante fuori. Una pizza di"
    },
    {
      "shot_idx": 23,
      "start": 46.9,
      "end": 49.333,
      "dur": 2.433,
      "transcript": "certo non leggera ma che mantiene comunque un tocco di"
    },
    {
      "shot_idx": 24,
      "start": 49.333,
      "end": 51.567,
      "dur": 2.233,
      "transcript": "freschezza grazie alla veluta tal basilico e il pomodoro."
    },
    {
      "shot_idx": 25,
      "start": 51.567,
      "end": 53.1,
      "dur": 1.533,
      "transcript": "Dopodiché ho assaggiato questa pizza"
    },
    {
      "shot_idx": 26,
      "start": 53.1,
      "end": 54.7,
      "dur": 1.6,
      "transcript": "casatiello, una loro limited"
    },
