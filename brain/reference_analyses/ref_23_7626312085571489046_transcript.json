      "shot_idx": 28,
      "start": 56.1,
      "end": 57.667,
      "dur": 1.567,
      "transcript": "con provola di agerola Salame"
    },
    {
      "shot_idx": 29,
      "start": 57.667,
      "end": 60.5,
      "dur": 2.833,
      "transcript": "Napoli, ovviamente uovo Sodo e cornicione ripieno con provolone"
