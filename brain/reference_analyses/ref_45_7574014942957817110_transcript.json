  "aligned_shots": [
    {
      "shot_idx": 0,
      "start": 0.0,
      "end": 2.033,
      "dur": 2.033,
      "transcript": "Il miglior ramen gluten free a Milano? Oggi"
    },
    {
      "shot_idx": 1,
      "start": 2.033,
      "end": 4.533,
      "dur": 2.5,
      "transcript": "ragazzi vi porto a provare un ramen che mi ha particolarmente"
    },
    {
      "shot_idx": 2,
      "start": 4.533,
      "end": 6.933,
      "dur": 2.4,
      "transcript": "stupito ovviamente senza glutine. Siamo da Dim"
    },
    {
      "shot_idx": 3,
      "start": 6.933,
      "end": 8.433,
      "dur": 1.5,
      "transcript": "Ramen in Guiale -Belgnui, ovvero"
    },
    {
      "shot_idx": 4,
      "start": 8.433,
      "end": 9.8,
      "dur": 1.367,
      "transcript": "un piccolo locale che ha però"
    },
    {
      "shot_idx": 5,
      "start": 9.8,
      "end": 15.833,
      "dur": 6.033,
      "transcript": "un intero menu dedicato al gluten free, comprendendo quindi sia gli antipasti che i veri e propri ramen. Appena seduti vi"
    },
    {
      "shot_idx": 6,
      "start": 15.833,
      "end": 18.067,
      "dur": 2.233,
      "transcript": "servono queste verdurine con una salsa sese, ma ho"
    },
    {
      "shot_idx": 7,
      "start": 18.067,
      "end": 19.667,
      "dur": 1.6,
      "transcript": "giusto per iniziare. Dopodiché noi abbiamo"
    },
    {
      "shot_idx": 8,
      "start": 19.667,
      "end": 22.133,
      "dur": 2.467,
      "transcript": "ordinato due involtini di gambri, diciamo tra l 'altro"
    },
    {
      "shot_idx": 9,
      "start": 22.133,
      "end": 23.767,
      "dur": 1.633,
      "transcript": "servito con anche la salsa di soia"
    },
    {
      "shot_idx": 10,
      "start": 23.767,
      "end": 26.833,
      "dur": 3.067,
      "transcript": "gluten free. In voltini con gambri e verdure molto buoni, soprattutto se"
    },
    {
      "shot_idx": 11,
      "start": 26.833,
      "end": 28.433,
      "dur": 1.6,
      "transcript": "accompagnati con questa salsa sinagro dolce"
    },
    {
      "shot_idx": 12,
      "start": 28.433,
      "end": 30.933,
      "dur": 2.5,
      "transcript": "che ovviamente ci sta benissimo con gli involtini. Passando invece"
    },
    {
      "shot_idx": 13,
      "start": 30.933,
      "end": 35.9,
      "dur": 4.967,
      "transcript": "al punto forte ovvero il loro ramen senza glutine ho provato questo con anche ravioli di carne, oltre ovviamente"
    },
    {
      "shot_idx": 14,
      "start": 35.9,
      "end": 38.9,
      "dur": 3.0,
      "transcript": "al paccioio, il cipollotto, al uacame e al uovo. I"
    },
    {
      "shot_idx": 15,
      "start": 38.9,
      "end": 42.8,
      "dur": 3.9,
      "transcript": "noodles avevano questo formato simile tagliatella. M 'erano davvero molto buoni, soprattutto molto"
    },
    {
      "shot_idx": 16,
      "start": 42.8,
      "end": 45.8,
      "dur": 3.0,
      "transcript": "saporiti insieme ovviamente al brodo del ramen, così proprio"
    },
    {
      "shot_idx": 17,
      "start": 45.8,
      "end": 49.5,
      "dur": 3.7,
      "transcript": "come lo erano anche ravioli. Dopodiché però ho voluto comunque assaggiare un ramen normale"
    },
    {
      "shot_idx": 18,
      "start": 49.5,
      "end": 51.867,
      "dur": 2.367,
      "transcript": "e per quanto il brodo potesse sembrare più denso era"
    },
    {
      "shot_idx": 19,
      "start": 51.867,
      "end": 53.9,
      "dur": 2.033,
      "transcript": "decisamente meno saporito con un sapore molto"
    },
    {
      "shot_idx": 20,
      "start": 53.9,
      "end": 55.867,
      "dur": 1.967,
      "transcript": "più leggero rispetto a quello senza glutine, che"
    },
    {
      "shot_idx": 21,
      "start": 55.867,
      "end": 57.667,
      "dur": 1.8,
      "transcript": "mi ha stupito parecchio perché solitamente è"
    },
    {
      "shot_idx": 22,
      "start": 57.667,
      "end": 60.633,
      "dur": 2.967,
      "transcript": "il contrario. Non in caso il prodotto resta ottimo in entrambe le sue"
    },
    {
      "shot_idx": 23,
      "start": 60.633,
      "end": 62.833,
      "dur": 2.2,
      "transcript": "forme, ed è per questo che ve lo consiglio se siete"
    },
    {
      "shot_idx": 24,
      "start": 62.833,
      "end": 65.667,
      "dur": 2.833,
      "transcript": "intolleranti al glutine o cegliaci, sia se non lo siete."
    },
    {
      "shot_idx": 25,
      "start": 65.667,
      "end": 68.7,
      "dur": 3.033,
      "transcript": "Ah, e per concludere biscotto della fortuna e molci gluten free."
    }
