    },
    {
      "shot_idx": 6,
      "start": 10.667,
      "end": 12.267,
      "dur": 1.6,
      "transcript": "nella palestra dell 'hotel e un caffè."
    },
    {
      "shot_idx": 7,
      "start": 12.267,
      "end": 14.167,
      "dur": 1.9,
      "transcript": "E oggi si gira un po' osti."
    },
    {
      "shot_idx": 8,
      "start": 14.167,
      "end": 16.2,
      "dur": 2.033,
      "transcript": "Fatto un giro nella città visitando il Texas"
    },
    {
      "shot_idx": 9,
      "start": 16.2,
      "end": 17.8,
      "dur": 1.6,
      "transcript": "Capitol, sarebbe il Campidoglio."
    },
    {
      "shot_idx": 10,
      "start": 17.8,
      "end": 20.8,
      "dur": 3.0,
      "transcript": ""
    },
    {
      "shot_idx": 11,
      "start": 20.8,
      "end": 23.067,
      "dur": 2.267,
      "transcript": "E"
    },
    {
      "shot_idx": 12,
      "start": 23.067,
      "end": 26.933,
      "dur": 3.867,
      "transcript": "devo dire che è un edificio piuttosto imponente, essendo il più grande Campidoglio di tutti gli Stati"
    },
    {
      "shot_idx": 13,
      "start": 26.933,
      "end": 27.667,
      "dur": 0.733,
      "transcript": "Uniti. E dopo"
    },
    {
      "shot_idx": 14,
      "start": 27.667,
      "end": 29.233,
      "dur": 1.567,
      "transcript": "di che i ragazzi arrivato all 'oraggio del pranzo"
    },
    {
      "shot_idx": 15,
      "start": 29.233,
      "end": 31.2,
      "dur": 1.967,
      "transcript": "e quindi dovuto provare semplicemente quello che"
    },
    {
      "shot_idx": 16,
      "start": 31.2,
      "end": 34.2,
      "dur": 3.0,
      "transcript": "è probabilmente il miglior barbecue di tutto il mondo. O almeno sicuramente"
    },
    {
      "shot_idx": 17,
      "start": 34.2,
      "end": 35.767,
      "dur": 1.567,
      "transcript": "uno dei più famosi, ovvero Franklin"
    },
    {
      "shot_idx": 18,
      "start": 35.767,
      "end": 37.767,
      "dur": 2.0,
      "transcript": "Barbecue. Dove stranamente non c 'era fila ma"
    },
    {
      "shot_idx": 19,
      "start": 37.767,
      "end": 39.6,
      "dur": 1.833,
      "transcript": "avevano già finito diversi pezzi. Ma il nostro"
    },
