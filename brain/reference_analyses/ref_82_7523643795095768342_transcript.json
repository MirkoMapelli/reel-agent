      "shot_idx": 30,
      "start": 59.233,
      "end": 61.6,
      "dur": 2.367,
      "transcript": "in una golgime e quindi semplicemente ho fatto un giro all 'interno."
    },
    {
      "shot_idx": 31,
      "start": 61.6,
      "end": 63.1,
      "dur": 1.5,
      "transcript": "Che sogno è mai questo?"
    },
    {
      "shot_idx": 32,
      "start": 63.1,
      "end": 64.467,
      "dur": 1.367,
      "transcript": "Cardio?"
