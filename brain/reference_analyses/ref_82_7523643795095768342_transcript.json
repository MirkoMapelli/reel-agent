      "shot_idx": 27,
      "start": 53.033,
      "end": 55.6,
      "dur": 2.567,
      "transcript": "Il migliore briscate di tutta la mia vita."
    },
    {
      "shot_idx": 28,
      "start": 55.6,
      "end": 57.567,
      "dur": 1.967,
      "transcript": "E dopo aver fatto questa esperienza clamorosa ho continuato"
    },
